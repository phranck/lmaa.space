{
  "name": "@lmaa/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file=.env.local --watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "docs:build": "tsx src/docs/export-openapi.ts && periwinkle build --out docs-dist",
    "db:doctor": "tsx --env-file=.env.local src/db/doctor.ts",
    "db:migrate": "tsx --env-file=.env.local src/db/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "email:preview": "npx react-email dev --dir src/emails --port 3001"
  },
  "dependencies": {
    "@atproto/api": "^0.19.15",
    "@aws-sdk/client-s3": "^3.1009.0",
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.4.3",
    "@lmaa/contracts": "0.1.0",
    "@lmaa/shared": "0.1.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "hono": "^4.12.18",
    "marked": "^17.0.3",
    "pino": "^10.3.1",
    "postgres": "^3.4.5",
    "sharp": "^0.35.3",
    "tldts": "^7.0.25",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "periwinkle": "^0.4.0",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.4",
    "react-email": "^5.2.8",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  }
}
