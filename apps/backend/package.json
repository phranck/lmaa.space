{
  "name": "@lmaa/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx --env-file=.env.local --watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.local src/db/migrate.ts",
    "db:seed": "tsx --env-file=.env.local src/scripts/seed.ts",
    "db:fetch-og": "tsx --env-file=.env.local src/scripts/fetch-og-images.ts",
    "email:preview": "npx react-email dev --dir src/emails --port 3001"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.4.3",
    "@lmaa/shared": "0.1.0",
    "@react-email/components": "^1.0.8",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.4",
    "hono": "^4.7.4",
    "postgres": "^3.4.5",
    "react": "^19.2.4",
    "react-email": "^5.2.8",
    "resend": "^4.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@react-email/preview-server": "^5.2.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.30.4",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
