---
import type { FooterConfig, FooterColumn } from "@lmaa/contracts";
import type { NavItem } from "@lmaa/shared";
import { FOOTER_STYLES_CSS, footerStyleVars } from "@lmaa/shared";
import { getButtonIconComponent, PLATFORM_MAP } from "@lmaa/ui";

import { renderMarkdownSSR as renderMarkdown } from "@/lib/markdown-ssr";
import { getSafeConfigHref, isExternalHref } from "@/lib/safe-url";

export interface SocialMediaProfile {
  platform: string;
  profileUrl: string;
  label: string;
}

interface Props {
  config: FooterConfig;
  navItems: NavItem[];
  socialMediaProfiles?: SocialMediaProfile[];
}

const { config, navItems, socialMediaProfiles = [] } = Astro.props;

const textBlockHtmlMap = new Map<string, string>();
for (const col of config.columns) {
  for (const block of col.blocks) {
    if (block.type === "text") {
      textBlockHtmlMap.set(block.id, await renderMarkdown(block.markdown));
    }
  }
}

const totalSpan = config.columns.reduce((sum, col) => sum + col.span, 0) || 1;
---

{config.columns.length > 0 && (
  <footer class="footer-root" style={footerStyleVars(config.style)}>
    <div class="footer-inner">
      <div class="footer-grid" style={`--footer-cols:${totalSpan}`}>
        {config.columns.map((col: FooterColumn) => (
          <div class="footer-col" style={`--col-span:${col.span}`}>
            {col.blocks.map((block) => {
              if (block.type === "headline") {
                return <p class="footer-headline">{block.text}</p>;
              }

              if (block.type === "text") {
                const html = textBlockHtmlMap.get(block.id) ?? "";
                return <div class="footer-text" set:html={html} />;
              }

              if (block.type === "button") {
                const href = getSafeConfigHref(block.href);
                const isExternal = href !== null && block.external && isExternalHref(href);
                const styleClass = `footer-btn footer-btn-${block.style}`;
                const ButtonIcon = getButtonIconComponent(block.icon);
                return (
                  href ? (
                    <a
                      href={href}
                      target={isExternal ? "_blank" : undefined}
                      rel={isExternal ? "noopener noreferrer" : undefined}
                      class={styleClass}
                      aria-label={block.label ?? block.icon ?? undefined}
                    >
                      {ButtonIcon && (
                        <span class="footer-btn-icon" aria-hidden="true">
                          <ButtonIcon width={15} height={15} />
                        </span>
                      )}
                      {block.label && <span>{block.label}</span>}
                    </a>
                  ) : (
                    <span class={styleClass} aria-disabled="true">
                      {ButtonIcon && (
                        <span class="footer-btn-icon" aria-hidden="true">
                          <ButtonIcon width={15} height={15} />
                        </span>
                      )}
                      {block.label && <span>{block.label}</span>}
                    </span>
                  )
                );
              }

              if (block.type === "separator") {
                return <hr class="footer-separator" />;
              }

              if (block.type === "footer-nav") {
                const isHorizontal = block.direction === "horizontal";
                return (
                  <ul class={isHorizontal ? "footer-nav footer-nav-h" : "footer-nav"}>
                    {navItems.map((item) => {
                      const href =
                        getSafeConfigHref(item.url) ?? (item.pageSlug ? `/${item.pageSlug}` : null);
                      const label = item.label ?? item.pageTitle ?? href ?? "#";
                      const external =
                        href !== null && (item.target === "_blank" || isExternalHref(href));
                      return (
                        <li>
                          {href ? (
                            <a
                              href={href}
                              target={external ? "_blank" : undefined}
                              rel={external ? "noopener noreferrer" : undefined}
                              data-analytics-event="site-link-click"
                              data-analytics-kind="footer"
                              data-analytics-placement="footer-nav"
                              data-analytics-label={label}
                              data-analytics-href={href}
                            >
                              {label}
                            </a>
                          ) : (
                            <span>{label}</span>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                );
              }

              if (block.type === "social-media") {
                if (socialMediaProfiles.length === 0) return null;
                const align = block.align ?? "center";
                const iconSize = block.iconSize ?? "md";
                const iconPx = iconSize === "sm" ? 16 : iconSize === "lg" ? 24 : 20;
                // block.order is an ordering hint: listed platforms appear in
                // the saved order, then any unlisted profile follows in default
                // order so newly-added accounts surface without re-saving the
                // block.
                const orderKeys = block.order ?? [];
                const fromOrder = orderKeys
                  .map((key) => socialMediaProfiles.find((p) => p.platform === key))
                  .filter(Boolean) as SocialMediaProfile[];
                const fromOrderKeys = fromOrder.map((p) => p.platform);
                const fromRest = socialMediaProfiles.filter(
                  (p) => !fromOrderKeys.includes(p.platform),
                );
                const ordered = [...fromOrder, ...fromRest];
                if (ordered.length === 0) return null;
                return (
                  <div class={`footer-social footer-social-${align} footer-social-${iconSize}`}>
                    {ordered.map((p) => {
                      const def = PLATFORM_MAP.get(p.platform);
                      const Icon = def?.icon;
                      const ariaLabel = p.label || def?.label || p.platform;
                      return (
                        <a
                          href={p.profileUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={ariaLabel}
                          title={ariaLabel}
                          data-analytics-event="site-link-click"
                          data-analytics-kind="footer"
                          data-analytics-placement="footer-social"
                          data-analytics-platform={p.platform}
                        >
                          {Icon ? <Icon size={iconPx} /> : <span>{ariaLabel}</span>}
                        </a>
                      );
                    })}
                  </div>
                );
              }

              return null;
            })}
          </div>
        ))}
      </div>
    </div>
  </footer>
)}

<style set:html={FOOTER_STYLES_CSS} />
