---
import { getSafeConfigHref } from "@/lib/safe-url";

interface Props {
  photographer: string;
  photographerUrl: string;
  gradient?: boolean;
  class?: string;
}

const UTM = "?utm_source=lmaa_space&utm_medium=referral";
const { photographer, photographerUrl, gradient = false, class: className = "" } = Astro.props;
const safeProfileUrl = getSafeConfigHref(photographerUrl);
---

<div class:list={["absolute inset-x-0 bottom-0", className]}>
  {gradient && (
    <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent pointer-events-none" />
  )}
  <p class="relative text-[9px] text-white/70 drop-shadow-sm text-right px-2 py-1.5">
    Photo{" "}
    {safeProfileUrl ? (
      <a href={`${safeProfileUrl}${UTM}`} target="_blank" rel="noopener noreferrer" class="font-semibold hover:text-white/90">
        {photographer}
      </a>
    ) : (
      <span class="font-semibold">{photographer}</span>
    )}
    {" @ "}
    <a href={`https://unsplash.com${UTM}`} target="_blank" rel="noopener noreferrer" class="font-semibold hover:text-white/90">
      Unsplash
    </a>
  </p>
</div>
