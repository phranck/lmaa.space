---
interface Props {
  variant: "desktop" | "mobile-header";
}

const { variant } = Astro.props;

/**
 * The label says what the click actually does, which is to open a page.
 *
 * "Ich liebe das Projekt" asked a first-time visitor to declare a feeling they
 * cannot have yet, and "Ich helfe mit" would claim an act the click does not
 * perform. Belonging is the one of the three with a field experiment behind it:
 * Huck and Rasul raised the average gift from 74.30 to 132 euro by announcing a
 * single lead donor, at an unchanged price of giving. The sponsor list carries
 * two names, so there is something to join.
 */
const label = "Ich will dabei sein";
const visibleLabel = variant === "mobile-header" ? "Unterstützen" : label;
const href = "/support-me";

// The outlined call to action takes the colours of the header's controls: ink
// in Papier, gold in Salon.
const outline =
  "items-center gap-1.5 h-9 rounded-full text-sm font-medium text-[var(--ds-header-control-text)] border border-[var(--ds-header-control-border)] hover:bg-[var(--ds-header-control-hover-bg)] transition-colors";
const classes =
  variant === "desktop"
    ? `hidden lg:flex px-3 ${outline}`
    : `inline-flex lg:hidden px-4 whitespace-nowrap ${outline}`;

const placement = variant === "desktop" ? "header" : "header-mobile";
---

<a
  href={href}
  class={classes}
  data-analytics-event="site-link-click"
  data-analytics-kind="cta"
  data-analytics-placement={placement}
  data-analytics-label={visibleLabel}
  data-analytics-href={href}
>
  <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">
    <path
      fill="currentColor"
      opacity="0.25"
      d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
    />
    <path
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"
    />
  </svg>
  {variant === "desktop" ? <span class="hidden sm:inline">{visibleLabel}</span> : visibleLabel}
</a>
