---
interface Props {
	variant: "desktop" | "mobile";
}

const { variant } = Astro.props;

const label = "Ich liebe das Projekt";
const href = "/support-me";

const classes =
	variant === "desktop"
		? "hidden md:flex items-center gap-1.5 h-9 px-3 rounded-full text-sm font-medium text-[var(--ds-accent)] border border-[var(--ds-accent)]/40 hover:bg-[var(--ds-accent-subtle)] transition-colors"
		: "flex items-center gap-2 h-9 px-3 rounded-control bg-[var(--ds-accent)] text-white text-sm font-medium hover:opacity-90 transition-opacity w-full justify-center";

const placement = variant === "desktop" ? "header" : "header-mobile-menu";
---

<a
	href={href}
	class={classes}
	data-analytics-event="site-link-click"
	data-analytics-kind="cta"
	data-analytics-placement={placement}
	data-analytics-label={label}
	data-analytics-href={href}
>
	{variant === "desktop" && (
		<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
		</svg>
	)}
	{variant === "desktop" ? <span class="hidden sm:inline">{label}</span> : label}
</a>
