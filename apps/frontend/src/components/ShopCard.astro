---
import ShopAvatar from "@/components/ShopAvatar.astro";
import { shopDomain } from "@/lib/shop";
import type { Shop } from "@lmaa/shared";

interface Props {
  shop: Shop;
  detailHref: string;
}

const { shop, detailHref } = Astro.props;

const domain = shopDomain(shop.url);
const hasCoordinates = shop.headquarters?.latitude != null && shop.headquarters?.longitude != null;

const MAX_PILLS = 2;
const visibleCategories = shop.categories?.slice(0, MAX_PILLS) ?? [];
const extraCount = (shop.categories?.length ?? 0) - MAX_PILLS;
---

<a
  href={detailHref}
  class="relative block bg-white rounded-2xl border border-stone-200 p-2 sm:p-4 hover:border-stone-300 hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
  data-analytics-event="shop-card-click"
  data-shop-id={String(shop.id)}
  data-shop-name={shop.name}
>
  <span
    class="shop-like-indicator absolute -right-2 -top-2 text-red-500 hidden z-10"
    data-like-indicator
    aria-hidden="true"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" class="w-5 h-5" fill="currentColor">
      <path d="M240,98a57.63,57.63,0,0,1-17,41L133.7,229.62a8,8,0,0,1-11.4,0L33,139a58,58,0,0,1,82-82.1L128,69.05l13.09-12.19A58,58,0,0,1,240,98Z" opacity="0.2" />
      <path d="M178,40c-20.65,0-38.73,8.88-50,23.89C116.73,48.88,98.65,40,78,40a62.07,62.07,0,0,0-62,62c0,70,103.79,126.66,108.21,129a8,8,0,0,0,7.58,0C136.21,228.66,240,172,240,102A62.07,62.07,0,0,0,178,40ZM128,214.8C109.74,204.16,32,155.69,32,102A46.06,46.06,0,0,1,78,56c19.45,0,35.78,10.36,42.6,27a8,8,0,0,0,14.8,0c6.82-16.67,23.15-27,42.6-27a46.06,46.06,0,0,1,46,46C224,155.61,146.24,204.15,128,214.8Z" />
    </svg>
  </span>
  {hasCoordinates && (
    <span class="absolute top-2 right-2 text-stone-300" title="Standort verfügbar">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" class="w-3.5 h-3.5" fill="currentColor">
        <path d="M128,24a80,80,0,0,0-80,80c0,72,80,128,80,128s80-56,80-128A80,80,0,0,0,128,24Zm0,112a32,32,0,1,1,32-32A32,32,0,0,1,128,136Z" opacity="0.2" />
        <path d="M200,224H150.54A266.56,266.56,0,0,0,174,200.25c27.45-31.57,42-64.85,42-96.25a88,88,0,0,0-176,0c0,31.4,14.51,64.68,42,96.25A266.56,266.56,0,0,0,105.46,224H56a8,8,0,0,0,0,16H200a8,8,0,0,0,0-16ZM56,104a72,72,0,0,1,144,0c0,57.23-55.47,105-72,118C111.47,209,56,161.23,56,104Zm112,0a40,40,0,1,0-40,40A40,40,0,0,0,168,104Zm-64,0a24,24,0,1,1,24,24A24,24,0,0,1,104,104Z" />
      </svg>
    </span>
  )}
  <div class="flex items-center gap-3">
    <ShopAvatar name={shop.name} imageUrl={shop.ogImage} size="sm" />

    <!-- Name + domain -->
    <div class="flex-1 min-w-0">
      <h3 class="font-serif font-semibold text-stone-900 text-base leading-snug truncate">
        {shop.name}
      </h3>
      <p class="text-xs text-stone-600 mt-0.5 truncate">{domain}</p>
    </div>
  </div>

  <!-- Category pills -->
  {visibleCategories.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mt-3">
      {visibleCategories.map((cat) => (
        <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700/70">
          {cat.name}
        </span>
      ))}
      {extraCount > 0 && (
        <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-stone-50 text-stone-600">
          +{extraCount}
        </span>
      )}
    </div>
  )}
</a>
