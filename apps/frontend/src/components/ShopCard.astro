---
import { shopDomain } from "@/lib/shop";
import { REGION_CODES, type Shop } from "@lmaa/shared";

interface Props {
  shop: Shop;
  detailHref: string;
}

const { shop, detailHref } = Astro.props;

const domain = shopDomain(shop.url);
const sortedRegions = [...shop.region].sort(
  (a, b) => REGION_CODES.indexOf(a) - REGION_CODES.indexOf(b),
);

const MAX_PILLS = 2;
const visibleCategories = shop.categories?.slice(0, MAX_PILLS) ?? [];
const extraCount = (shop.categories?.length ?? 0) - MAX_PILLS;
---

<a
  href={detailHref}
  class="block bg-white rounded-2xl border border-stone-200 p-4 hover:shadow-md hover:border-stone-300 transition-all duration-200"
  data-analytics-event="shop-card-click"
  data-shop-id={String(shop.id)}
  data-shop-name={shop.name}
>
  <div class="flex items-center gap-3">
    <!-- og:image -->
    <div class="shrink-0 w-12 h-12 rounded-lg overflow-hidden border border-stone-100 bg-stone-50 flex items-center justify-center">
      {shop.ogImage ? (
        <img
          src={shop.ogImage}
          alt=""
          aria-hidden="true"
          loading="lazy"
          class="w-full h-full object-contain"
          data-img-fallback
        />
        <span class="text-lg font-bold text-stone-300 select-none hidden items-center justify-center w-full h-full">
          {shop.name.charAt(0).toUpperCase()}
        </span>
      ) : (
        <span class="text-lg font-bold text-stone-300 select-none">
          {shop.name.charAt(0).toUpperCase()}
        </span>
      )}
    </div>

    <!-- Name + domain + regions -->
    <div class="flex-1 min-w-0">
      <h3 class="font-serif font-semibold text-stone-900 text-base leading-snug truncate">
        {shop.name}
      </h3>
      <p class="text-xs text-stone-400 mt-0.5 truncate">{domain}</p>
    </div>

    <!-- Region badges (hidden on very small screens) -->
    {sortedRegions.length > 0 && (
      <div class="hidden sm:flex flex-wrap gap-1 shrink-0">
        {sortedRegions.map((r) => (
          <span class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-700 text-xs font-medium border border-amber-100">
            {r}
          </span>
        ))}
      </div>
    )}
  </div>

  <!-- Category pills -->
  {visibleCategories.length > 0 && (
    <div class="flex flex-wrap gap-1.5 mt-3">
      {visibleCategories.map((cat) => (
        <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700/70">
          {cat.name}
        </span>
      ))}
      {extraCount > 0 && (
        <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-stone-50 text-stone-400">
          +{extraCount}
        </span>
      )}
    </div>
  )}
</a>
