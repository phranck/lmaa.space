---
import type { NavItem } from "@lmaa/shared";
import { getSafeConfigHref, isExternalHref } from "@/lib/safe-url";
import SupportButton from "@/components/SupportButton.astro";

interface Props {
  navItems: NavItem[];
}

const { navItems } = Astro.props;

const currentPath = Astro.url.pathname;

function navLinkClass(href: string, external = false) {
  const isActive =
    !external && (currentPath === href || (href !== "/" && currentPath.startsWith(href)));
  return `font-serif text-lg tracking-wide transition-colors ${
    isActive ? "text-amber-700 font-semibold" : "text-stone-900 hover:text-stone-950"
  }`;
}
---

<header class="sticky top-0 z-50 bg-stone-50/95 backdrop-blur-sm border-b border-stone-200">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Left: Logo + Desktop Nav -->
      <div class="flex items-center gap-10">
        <a href="/" class="flex items-center hover:opacity-80 transition-opacity">
          <img src="/logo.png" alt="lmaa.space" class="h-8 w-auto" />
        </a>

        <div class="hidden md:flex items-center gap-8">
          {navItems.map((item) => {
            const href = getSafeConfigHref(item.url) ?? (item.pageSlug ? `/${item.pageSlug}` : null);
            const label = item.label ?? item.pageTitle ?? href ?? "#";
            const external = href !== null && (item.target === "_blank" || isExternalHref(href));
            return href === null ? (
              <span class={navLinkClass("#")}>{label}</span>
            ) : external ? (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class={navLinkClass(href, true)}
                data-analytics-event="site-link-click"
                data-analytics-kind="nav"
                data-analytics-placement="header"
                data-analytics-label={label}
                data-analytics-href={href}
              >
                {label}
              </a>
            ) : (
              <a
                href={href}
                class={navLinkClass(href ?? "")}
                data-analytics-event="site-link-click"
                data-analytics-kind="nav"
                data-analytics-placement="header"
                data-analytics-label={label}
                data-analytics-href={href}
              >
                {label}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Right: My Shops + Donate + Mobile toggle -->
      <div class="flex items-center gap-5">
        <a
          href="/my-shops"
          class="hidden items-center gap-1.5 font-serif text-lg tracking-wide text-stone-900 hover:text-amber-700 transition-colors"
          data-my-shops-link="desktop"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" class="hidden sm:block w-4 h-4 text-red-500" fill="currentColor" aria-hidden="true">
            <path d="M240,98a57.63,57.63,0,0,1-17,41L133.7,229.62a8,8,0,0,1-11.4,0L33,139a58,58,0,0,1,82-82.1L128,69.05l13.09-12.19A58,58,0,0,1,240,98Z" opacity="0.2" />
            <path d="M178,40c-20.65,0-38.73,8.88-50,23.89C116.73,48.88,98.65,40,78,40a62.07,62.07,0,0,0-62,62c0,70,103.79,126.66,108.21,129a8,8,0,0,0,7.58,0C136.21,228.66,240,172,240,102A62.07,62.07,0,0,0,178,40ZM128,214.8C109.74,204.16,32,155.69,32,102A46.06,46.06,0,0,1,78,56c19.45,0,35.78,10.36,42.6,27a8,8,0,0,0,14.8,0c6.82-16.67,23.15-27,42.6-27a46.06,46.06,0,0,1,46,46C224,155.61,146.24,204.15,128,214.8Z" />
          </svg>
          Meine Shops
        </a>
        <SupportButton variant="desktop" />

        <!-- Mobile hamburger -->
        <details class="md:hidden relative" id="mobile-menu-details">
          <summary class="p-2 rounded-md text-stone-800 hover:text-stone-950 hover:bg-stone-100 transition-colors cursor-pointer" aria-label="Menü öffnen/schließen">
            <!-- Hamburger icon (shows when closed, hidden via CSS when open) -->
            <svg class="block open:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </summary>

          <div class="fixed left-0 right-0 top-16 pb-4 pt-2 space-y-1 border-t border-stone-100 bg-stone-50 shadow-lg">
            <!-- Mobile Search -->
            <form
              action="/search"
              method="get"
              class="px-1 pb-2"
              data-analytics-search-source="header-mobile"
            >
              <div class="relative">
                <input
                  name="q"
                  type="search"
                  placeholder="Shops oder Kategorien suchen…"
                  aria-label="Shops suchen"
                  class="w-full pl-9 pr-3 py-2 text-sm rounded-lg border border-stone-200 bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/40"
                />
                <svg
                  class="absolute left-3 top-1/2 -translate-y-1/2 text-stone-500 pointer-events-none"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="11" cy="11" r="8"></circle>
                  <path d="m21 21-4.35-4.35"></path>
                </svg>
              </div>
            </form>

            {navItems.map((item) => {
              const href = getSafeConfigHref(item.url) ?? (item.pageSlug ? `/${item.pageSlug}` : null);
              const label = item.label ?? item.pageTitle ?? href ?? "#";
              const external = href !== null && (item.target === "_blank" || isExternalHref(href));
              const isActive = href !== null && (currentPath === href || (href !== "/" && currentPath.startsWith(href)));
              return href === null ? (
                <span class="block px-3 py-2 rounded-md font-serif text-lg transition-colors text-stone-800">
                  {label}
                </span>
              ) : external ? (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block px-3 py-2 rounded-md font-serif text-lg transition-colors text-stone-800 hover:bg-stone-100"
                  data-analytics-event="site-link-click"
                  data-analytics-kind="nav"
                  data-analytics-placement="header-mobile-menu"
                  data-analytics-label={label}
                  data-analytics-href={href}
                >
                  {label}
                </a>
              ) : (
                <a
                  href={href}
                  class={`block px-3 py-2 rounded-md font-serif text-lg transition-colors ${
                    isActive ? "text-amber-700 bg-amber-50 font-semibold" : "text-stone-800 hover:bg-stone-100"
                  }`}
                  data-analytics-event="site-link-click"
                  data-analytics-kind="nav"
                  data-analytics-placement="header-mobile-menu"
                  data-analytics-label={label}
                  data-analytics-href={href}
                >
                  {label}
                </a>
              );
            })}

            <a
              href="/my-shops"
              class="hidden px-3 py-2 rounded-md font-serif text-lg transition-colors text-stone-800 hover:bg-stone-100"
              data-my-shops-link="mobile"
            >
              Meine Shops
            </a>

            <div class="pt-1 px-1">
              <SupportButton variant="mobile" />
            </div>
          </div>
        </details>

      </div>
    </div>
  </nav>
</header>

<script>
  // Click-outside to close mobile menu
  document.addEventListener("click", (e) => {
    const mobile = document.getElementById("mobile-menu-details") as HTMLDetailsElement | null;
    if (mobile?.open && !mobile.contains(e.target as Node)) {
      mobile.removeAttribute("open");
    }
  });

  // Show "Meine Shops" nav links when user has liked shops
  try {
    const raw = localStorage.getItem("lmaa-liked-shops");
    const liked = raw ? (JSON.parse(raw) as string[]) : [];
    if (liked.length > 0) {
      document.querySelectorAll<HTMLElement>("[data-my-shops-link]").forEach((el) => {
        el.classList.remove("hidden");
        if (el.dataset.myShopsLink === "desktop") {
          el.classList.add("md:flex");
        } else {
          el.classList.add("block");
        }
      });
    }
  } catch {
    // localStorage unavailable
  }
</script>
