---
import type { NavItem } from "@lmaa/shared";

interface Props {
  navItems: NavItem[];
}

const { navItems } = Astro.props;

const currentPath = Astro.url.pathname;

function navLinkClass(href: string, external = false) {
  const isActive =
    !external && (currentPath === href || (href !== "/" && currentPath.startsWith(href)));
  return `font-serif text-lg tracking-wide transition-colors ${
    isActive ? "text-amber-700 font-semibold" : "text-stone-500 hover:text-stone-900"
  }`;
}
---

<header class="sticky top-0 z-50 bg-stone-50/95 backdrop-blur-sm border-b border-stone-200">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">

      <!-- Left: Logo + Desktop Nav -->
      <div class="flex items-center gap-10">
        <a href="/" class="flex items-center hover:opacity-80 transition-opacity">
          <img src="/logo.png" alt="lmaa.space" class="h-8 w-auto" />
        </a>

        <div class="hidden md:flex items-center gap-8">
          {navItems.map((item) => {
            const href = item.url ?? `/${item.pageSlug}`;
            const label = item.label ?? item.pageTitle ?? href;
            const external = item.target === "_blank" || (item.url?.startsWith("http") ?? false);
            return external ? (
              <a
                href={href}
                target="_blank"
                rel="noopener noreferrer"
                class={navLinkClass(href, true)}
                data-analytics-event="site-link-click"
                data-analytics-kind="nav"
                data-analytics-placement="header"
                data-analytics-label={label}
                data-analytics-href={href}
              >
                {label}
              </a>
            ) : (
              <a
                href={href}
                class={navLinkClass(href ?? "")}
                data-analytics-event="site-link-click"
                data-analytics-kind="nav"
                data-analytics-placement="header"
                data-analytics-label={label}
                data-analytics-href={href}
              >
                {label}
              </a>
            );
          })}
        </div>
      </div>

      <!-- Right: Search + Donate + Mobile toggle -->
      <div class="flex items-center gap-2">

        <!-- Desktop Search -->
        <form
          action="/search"
          method="get"
          class="hidden md:flex items-center"
          data-analytics-search-source="header-desktop"
        >
          <div class="relative">
            <input
              name="q"
              type="search"
              placeholder="Suchen…"
              aria-label="Shops suchen"
              class="w-48 pl-9 pr-3 py-1.5 text-sm rounded-full border border-stone-300 bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/40 focus:border-amber-500 transition-all"
            />
            <!-- Magnifying glass icon -->
            <svg
              class="absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 pointer-events-none"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
          </div>
        </form>

        <!-- Donate (desktop) -->
        <a
          href="/support-me"
          class="hidden md:flex items-center gap-1.5 h-9 px-3 rounded-full text-sm font-medium text-[var(--ds-accent)] border border-[var(--ds-accent)]/40 hover:bg-[var(--ds-accent-subtle)] transition-colors"
          data-analytics-event="site-link-click"
          data-analytics-kind="cta"
          data-analytics-placement="header"
          data-analytics-label="Unterstützen"
          data-analytics-href="/support-me"
        >
          <!-- Heart icon -->
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
          <span class="hidden sm:inline">Unterstützen</span>
        </a>

        <!-- Mobile hamburger -->
        <details class="md:hidden" id="mobile-menu-details">
          <summary class="p-2 rounded-md text-stone-500 hover:text-stone-900 hover:bg-stone-100 transition-colors cursor-pointer" aria-label="Menü öffnen/schließen">
            <!-- Hamburger icon (shows when closed, hidden via CSS when open) -->
            <svg class="block open:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <line x1="3" y1="12" x2="21" y2="12"></line>
              <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
          </summary>

          <div class="pb-4 pt-2 space-y-1 border-t border-stone-100 bg-stone-50">
            <!-- Mobile Search -->
            <form
              action="/search"
              method="get"
              class="px-1 pb-2"
              data-analytics-search-source="header-mobile"
            >
              <div class="relative">
                <input
                  name="q"
                  type="search"
                  placeholder="Shop oder Kategorie suchen…"
                  aria-label="Shops suchen"
                  class="w-full pl-9 pr-3 py-2 text-sm rounded-lg border border-stone-200 bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/40"
                />
                <svg
                  class="absolute left-3 top-1/2 -translate-y-1/2 text-stone-400 pointer-events-none"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <circle cx="11" cy="11" r="8"></circle>
                  <path d="m21 21-4.35-4.35"></path>
                </svg>
              </div>
            </form>

            {navItems.map((item) => {
              const href = item.url ?? `/${item.pageSlug}`;
              const label = item.label ?? item.pageTitle ?? href;
              const external = item.target === "_blank" || (item.url?.startsWith("http") ?? false);
              const isActive = currentPath === href || (href !== "/" && currentPath.startsWith(href ?? ""));
              return external ? (
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block px-3 py-2 rounded-md font-serif text-lg transition-colors text-stone-600 hover:bg-stone-100"
                  data-analytics-event="site-link-click"
                  data-analytics-kind="nav"
                  data-analytics-placement="header-mobile-menu"
                  data-analytics-label={label}
                  data-analytics-href={href}
                >
                  {label}
                </a>
              ) : (
                <a
                  href={href}
                  class={`block px-3 py-2 rounded-md font-serif text-lg transition-colors ${
                    isActive ? "text-amber-700 bg-amber-50 font-semibold" : "text-stone-600 hover:bg-stone-100"
                  }`}
                  data-analytics-event="site-link-click"
                  data-analytics-kind="nav"
                  data-analytics-placement="header-mobile-menu"
                  data-analytics-label={label}
                  data-analytics-href={href}
                >
                  {label}
                </a>
              );
            })}

            <div class="pt-1 px-1">
              <a
                href="/support-me"
                class="flex items-center gap-2 h-9 px-3 rounded-control bg-[var(--ds-accent)] text-white text-sm font-medium hover:opacity-90 transition-opacity w-full justify-center"
                data-analytics-event="site-link-click"
                data-analytics-kind="cta"
                data-analytics-placement="header-mobile-menu"
                data-analytics-label="Unterstützen"
                data-analytics-href="/support-me"
              >
                Unterstützen
              </a>
            </div>
          </div>
        </details>

      </div>
    </div>
  </nav>
</header>

<script>
  // Click-outside to close mobile menu
  document.addEventListener("click", (e) => {
    const mobile = document.getElementById("mobile-menu-details") as HTMLDetailsElement | null;
    if (mobile?.open && !mobile.contains(e.target as Node)) {
      mobile.removeAttribute("open");
    }
  });
</script>
