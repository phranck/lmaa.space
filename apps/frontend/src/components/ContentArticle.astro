---
/**
 * Renders a content page's body.
 *
 * A content page is Markdown with shortcodes, so it arrives as a list of
 * segments: rendered HTML, or an island that has to run in the browser. Both
 * the public page and the dashboard preview render that list identically, and
 * this component is the one place that decides how.
 */
import RejectedShopsTable from "@/components/islands/RejectedShopsTable";
import SponsorWall from "@/components/SponsorWall.astro";
import SupportLadder from "@/components/islands/SupportLadder";
import type { RenderedContentSegment } from "@/lib/content-page-rendering";
import { EMPTY_SPONSORS, getSponsors } from "@/lib/sponsors";

interface Props {
  /** Page title, shown only when the page asks for it. */
  title: string;
  /** Whether the title is rendered above the content. */
  showTitle: boolean;
  /** Segments produced by `renderContentSegments`. */
  segments: RenderedContentSegment[];
}

const { title, showTitle, segments } = Astro.props;

/**
 * Both the wall and the sponsor tab of the ladder read the same figures, so the
 * page asks for them once. A page carrying neither asks for nothing.
 */
const needsSponsors = segments.some(
  (segment) =>
    segment.type === "sponsors" ||
    (segment.type === "support-ladder" &&
      segment.intervals.some((interval) => interval.key === "sponsor")),
);
const sponsors = needsSponsors ? await getSponsors() : EMPTY_SPONSORS;
const minSponsorAmountEur = Math.ceil(sponsors.minAmountCents / 100);
---

<article
  class="prose prose-stone prose-base max-w-none prose-a:text-amber-700 prose-a:no-underline hover:prose-a:underline prose-headings:font-serif"
>
  {showTitle && <h1>{title}</h1>}
  {
    segments.map((segment) => {
      if (segment.type === "html") {
        return <Fragment set:html={segment.html} />;
      }

      if (segment.type === "sponsors") {
        // The heading belongs to the article and is therefore left inside the
        // prose flow. Only the wall itself steps out of it, because its cards
        // bring their own type and spacing.
        return (
          <Fragment>
            {segment.title && <h2>{segment.title}</h2>}
            <div class="not-prose mb-10">
              <SponsorWall
                payload={sponsors}
                text={segment.text}
                covered={segment.covered}
                missing={segment.missing}
              />
            </div>
          </Fragment>
        );
      }

      if (segment.type === "support-ladder") {
        // No top margin: what stands above decides the gap, exactly as it does
        // between two paragraphs. Under a heading the island therefore sits as
        // close as any other block rather than a whole step lower.
        return (
          <div class="not-prose mb-10">
            <SupportLadder
              client:load
              bankAccount={segment.bankAccount}
              intervals={segment.intervals}
              routes={segment.routes}
              labels={segment.labels}
              minSponsorAmountEur={minSponsorAmountEur}
            />
          </div>
        );
      }

      return (
        <RejectedShopsTable
          client:load
          defaultPageSize={segment.defaultPageSize}
          initialData={segment.initialData}
          storageKey={segment.storageKey}
        />
      );
    })
  }
</article>
