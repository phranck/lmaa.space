---
import { resolveLogoBackground } from "@lmaa/shared";

interface Props {
  name: string;
  imageUrl?: string | null;
  logoBackgroundColor?: string | null;
  size?: "sm" | "md" | "lg";
}

const { name, imageUrl, logoBackgroundColor, size = "sm" } = Astro.props;

const letter = name.charAt(0).toUpperCase();
const bgColor = resolveLogoBackground(logoBackgroundColor);

const sizeClasses: Record<string, { container: string; letter: string }> = {
  sm: { container: "w-12 h-12 rounded-lg", letter: "text-lg" },
  md: { container: "w-20 h-20 sm:w-28 sm:h-28 rounded-2xl", letter: "text-3xl sm:text-4xl" },
  lg: { container: "w-24 h-24 sm:w-32 sm:h-32 rounded-2xl", letter: "text-4xl sm:text-5xl" },
};

const s = sizeClasses[size];
// The letter stands on the shop's logo ground, which is the same light colour
// in both themes, so its grey is fixed as well. It repeats the name that stands
// beside it, so a screen reader skips it.
---

<div
  class={`shrink-0 ${s.container} overflow-hidden border border-[var(--ds-border-subtle)] flex items-center justify-center`}
  style={`background-color: ${bgColor}`}
>
  {imageUrl ? (
    <>
      <img
        src={imageUrl}
        alt=""
        aria-hidden="true"
        loading="lazy"
        class="w-full h-full object-contain"
        referrerpolicy="no-referrer"
        data-img-fallback
      />
      <span
        class={`${s.letter} font-bold text-stone-300 select-none hidden items-center justify-center w-full h-full`}
        aria-hidden="true"
      >
        {letter}
      </span>
    </>
  ) : (
    <span class={`${s.letter} font-bold text-stone-300 select-none`} aria-hidden="true">
      {letter}
    </span>
  )}
</div>
