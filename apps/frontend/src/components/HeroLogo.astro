---
import Wordmark from "@lmaa/ui/marks/lmaa-wordmark.svg";
---

<!-- Inlined rather than linked as an image, because the drawing fills with the
     current text color and an image cannot inherit one. -->
<Wordmark
  role="img"
  aria-label="LMAA"
  class="block w-[325px] sm:w-[468px] h-auto mx-auto text-[var(--ds-accent)]"
/>
