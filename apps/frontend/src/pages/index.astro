---
import CategoryCard from "@/components/CategoryCard.astro";
import HeroLogo from "@/components/HeroLogo.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { apiGet } from "@/lib/api";
import type { Category } from "@lmaa/shared";

const categories = await apiGet<Category[]>("/categories");
const shopCount = categories.reduce((sum, c) => sum + (c.shopCount ?? 0), 0);

const site = Astro.site?.origin ?? "https://lmaa.space";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "lmaa.space",
  url: site,
  description: "Community-kuratiertes Verzeichnis von Amazon-Alternativen für den DACH-Raum",
  potentialAction: {
    "@type": "SearchAction",
    target: `${site}/search?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden text-white">
    <img
      src="/images/hero.jpg"
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-stone-950/70"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-12 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-amber-400 mb-4">
        Community-kuratiert · Unabhängig · Kostenlos
      </p>
      <div class="my-8">
        <HeroLogo />
      </div>
      <h1 class="font-serif text-stone-200 text-4xl mb-10 max-w-xl mx-auto leading-tight">
        Lokale Märkte.<br />
        Alternative <span style="color: var(--amazon-color); font-weight: bold;">Anbieter</span>.
      </h1>

      <form action="/search" method="get" class="max-w-lg mx-auto">
        <div class="flex gap-2 bg-white/10 backdrop-blur-sm rounded-2xl p-2 border border-white/10">
          <input
            name="q"
            type="search"
            placeholder="Shop oder Kategorie suchen…"
            class="flex-1 px-4 py-2.5 bg-transparent text-white placeholder-stone-400 text-sm focus:outline-none"
          />
          <button
            type="submit"
            class="px-5 py-2.5 text-white rounded-xl font-medium text-sm transition-colors shrink-0 bg-[var(--accent-base)] hover:bg-[var(--accent-hover)]"
          >
            Suchen
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- Divider -->
  <div class="h-px bg-gradient-to-r from-transparent via-amber-300 to-transparent"></div>

  <!-- Categories -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="flex items-baseline justify-between mb-8 px-[15px]">
      <h2 class="font-serif text-2xl font-semibold text-stone-800">Kategorien entdecken</h2>
      <span class="text-sm text-stone-400">
        {shopCount} Shops in {categories.length} Kategorien
      </span>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
      {categories.map((category) => (
        <CategoryCard category={category} />
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-amber-50 border-y border-amber-100">
    <div class="max-w-2xl mx-auto px-4 py-16 text-center">
      <h2 class="font-serif text-2xl font-semibold text-stone-800 mb-3">
        Vermisst du einen Shop?
      </h2>
      <p class="text-stone-500 mb-6 text-sm leading-relaxed">
        Hilf der Community und schlage deinen Shop vor. Schnell und ohne Anmeldung.
      </p>
      <a
        href="/suggestion"
        class="inline-block px-7 py-3 bg-stone-900 text-white rounded-xl font-medium text-sm hover:bg-stone-800 transition-colors"
      >
        Shop vorschlagen
      </a>
    </div>
  </section>
</BaseLayout>
