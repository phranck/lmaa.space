---
import FilterableCategoryGrid from "@/components/islands/FilterableCategoryGrid";
import HeroLogo from "@/components/HeroLogo.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { apiGet } from "@/lib/api";
import type { Category } from "@lmaa/shared";

const categories = await apiGet<Category[]>("/categories");
const stats = await apiGet<{ shopCount: number }>("/stats");
const shopCount = stats.shopCount;

interface HeroImageResult {
  url: string;
  photographer: string;
  photographerUrl: string;
  focalPointY: number;
  nextState: string | null;
}

const heroState = Astro.cookies.get("hero-state")?.value ?? "";
const heroImage = await apiGet<HeroImageResult | null>(
  heroState ? `/hero?state=${heroState}` : "/hero",
).catch(() => null);

if (heroImage?.nextState) {
  Astro.cookies.set("hero-state", heroImage.nextState, {
    path: "/",
    maxAge: 60 * 60 * 24 * 365,
    sameSite: "lax",
    httpOnly: false,
  });
}

const heroSrc = heroImage?.url ?? "/images/hero.jpg";

const site = Astro.site?.origin ?? "https://lmaa.space";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "lmaa.space",
  url: site,
  description: "Lokale Märkte. Alternative Anbieter.",
  potentialAction: {
    "@type": "SearchAction",
    target: `${site}/search?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden text-white">
    <img
      src={heroSrc}
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      class="absolute inset-0 w-full h-full object-cover"
      style={`object-position: 50% ${heroImage?.focalPointY ?? 50}%`}
    />
    <div class="absolute inset-0 bg-stone-950/70"></div>
    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-12 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-amber-400 mb-4">
        Kuratiert · Unabhängig · Kostenlos
      </p>
      <div class="my-8">
        <HeroLogo />
      </div>
      <h1 class="font-serif text-stone-200 text-4xl mb-10 max-w-xl mx-auto leading-tight">
        Lokale Märkte. Alternative <span style="color: var(--hero-highlight-color); font-weight: bold;">Anbieter</span>.
      </h1>

      <form
        action="/search"
        method="get"
        class="max-w-lg mx-auto"
        data-analytics-search-source="home"
      >
        <div class="flex gap-2 bg-white/10 backdrop-blur-sm rounded-2xl p-2 border border-white/10 transition-shadow focus-within:ring-2 focus-within:ring-[var(--accent-base)]">
          <div class="relative flex-1">
            <input
              id="hero-search"
              name="q"
              type="text"
              placeholder="Shop oder Kategorie suchen…"
              class="w-full px-4 pr-8 py-2.5 bg-transparent text-white placeholder-stone-400 text-sm focus:outline-none"
            />
            <span
              id="hero-search-shortcut"
              class="absolute right-1.5 top-1/2 -translate-y-1/2 text-stone-400 text-xs font-medium pointer-events-none hidden"
              aria-hidden="true"
            ></span>
            <button
              type="button"
              id="hero-search-clear"
              class="absolute right-1.5 top-1/2 -translate-y-1/2 text-stone-400 hover:text-stone-200 transition-colors hidden"
              aria-label="Suchfeld löschen"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256" class="w-5 h-5" fill="currentColor">
                <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm37.66,130.34a8,8,0,0,1-11.32,11.32L128,139.31l-26.34,26.35a8,8,0,0,1-11.32-11.32L116.69,128,90.34,101.66a8,8,0,0,1,11.32-11.32L128,116.69l26.34-26.35a8,8,0,0,1,11.32,11.32L139.31,128Z" opacity="0.2" />
                <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm0,192a88,88,0,1,1,88-88A88.1,88.1,0,0,1,128,216Zm37.66-130.34a8,8,0,0,1,0,11.32L139.31,128l26.35,26.34a8,8,0,0,1-11.32,11.32L128,139.31l-26.34,26.35a8,8,0,0,1-11.32-11.32L116.69,128,90.34,101.66a8,8,0,0,1,11.32-11.32L128,116.69l26.34-26.35A8,8,0,0,1,165.66,85.66Z" />
              </svg>
            </button>
          </div>
          <button
            type="submit"
            class="px-5 py-2.5 text-white rounded-lg font-medium text-sm transition-colors shrink-0 bg-[var(--accent-base)] hover:bg-[var(--accent-hover)]"
          >
            Suchen
          </button>
        </div>
        <script is:inline>
          (() => {
            const input = document.getElementById('hero-search');
            const btn = document.getElementById('hero-search-clear');
            const shortcut = document.getElementById('hero-search-shortcut');
            if (!input || !btn || !shortcut) return;

            // Detect platform and show shortcut badge (hidden on mobile/touch)
            const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;
            if (!isTouchDevice) {
              const isMac = /Mac|iPhone|iPad|iPod/.test(navigator.userAgent);
              shortcut.textContent = isMac ? '\u2318K' : '\u2303K';
              shortcut.classList.remove('hidden');
            }

            const toggle = () => {
              const hasValue = !!input.value;
              if (hasValue) {
                btn.classList.remove('hidden');
                shortcut.classList.add('hidden');
              } else {
                btn.classList.add('hidden');
                if (!isTouchDevice) shortcut.classList.remove('hidden');
              }
            };

            input.addEventListener('input', toggle);
            btn.addEventListener('click', () => { input.value = ''; toggle(); input.focus(); });
            toggle();

            // Keyboard shortcuts
            document.addEventListener('keydown', (e) => {
              if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
                e.preventDefault();
                input.focus();
              }
              if (e.key === 'Escape' && document.activeElement === input) {
                input.blur();
              }
            });
          })();
        </script>
      </form>
    </div>
  </section>

  <!-- Divider -->
  <div class="h-px bg-gradient-to-r from-transparent via-amber-300 to-transparent"></div>

  <!-- Categories (filterable) -->
  <FilterableCategoryGrid
    client:load
    categories={categories}
    shopCount={shopCount}
  />

  <!-- CTA -->
  <section class="bg-amber-50 border-y border-amber-100">
    <div class="max-w-2xl mx-auto px-4 py-16 text-center">
      <h2 class="font-serif text-2xl font-semibold text-stone-800 mb-3">
        Vermisst du einen Shop?
      </h2>
      <p class="text-stone-700 mb-6 text-sm leading-relaxed">
        Hilf der Community und schlage deinen Shop vor. Schnell und ohne Anmeldung.
      </p>
      <a
        href="/suggestion"
        class="inline-block px-7 py-3 bg-stone-900 text-white rounded-xl font-medium text-sm hover:bg-stone-800 transition-colors"
        data-analytics-event="site-link-click"
        data-analytics-kind="cta"
        data-analytics-placement="homepage"
        data-analytics-label="Shop vorschlagen"
        data-analytics-href="/suggestion"
      >
        Shop vorschlagen
      </a>
    </div>
  </section>
</BaseLayout>
