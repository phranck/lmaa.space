---
import type { ContentPage } from "@lmaa/shared";
import { apiGet } from "@/lib/api";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { renderMarkdown } from "@/lib/markdown";

const { slug } = Astro.params;

let page: ContentPage;
try {
  page = await apiGet<ContentPage>(`/content/${slug}`);
} catch {
  return Astro.redirect("/404");
}
const html = await renderMarkdown(page.content);

const description = page.content
  .replace(/#{1,6}\s+/g, "")
  .replace(/\*\*(.+?)\*\*/g, "$1")
  .replace(/\*(.+?)\*/g, "$1")
  .replace(/\[(.+?)\]\(.+?\)/g, "$1")
  .replace(/`(.+?)`/g, "$1")
  .replace(/\n+/g, " ")
  .trim()
  .slice(0, 160);
---

<BaseLayout
  title={page.title}
  description={description}
>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-14">
    <h1 class="font-serif text-3xl font-semibold text-stone-900 mb-10">{page.title}</h1>
    <article
      class="prose prose-stone prose-base max-w-none prose-a:text-amber-700 prose-a:no-underline hover:prose-a:underline prose-headings:font-serif"
      set:html={html}
    />
  </div>
</BaseLayout>
