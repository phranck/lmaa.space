---
import type { Category, Shop } from "@lmaa/shared";
import { apiGet } from "@/lib/api";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SearchIsland from "@/components/islands/SearchIsland";

const [shops, categories] = await Promise.all([
  apiGet<Shop[]>("/shops"),
  apiGet<Category[]>("/categories"),
]);
---

<BaseLayout
  title="Suche"
  description="Shops und Kategorien durchsuchen – faire Amazon-Alternativen auf lmaa.space."
  canonicalUrl="https://lmaa.space/suche"
>
  <SearchIsland client:load shops={shops} categories={categories} />
</BaseLayout>
