---
import type { MarkdownWidget } from "@lmaa/contracts";

const { key } = Astro.params;

function extractOrigins(value: string) {
  const matches = value.match(/https?:\/\/[^\s"'`<>)]+/g) ?? [];
  const origins = matches
    .map((entry) => {
      try {
        return new URL(entry).origin;
      } catch {
        return null;
      }
    })
    .filter((entry): entry is string => Boolean(entry));

  return [...new Set(origins)];
}

function getAutoOrigins(widget: MarkdownWidget) {
  if (widget.type === "iframe" && widget.iframeUrl) {
    try {
      const origin = new URL(widget.iframeUrl).origin;
      return {
        scriptSrc: [] as string[],
        styleSrc: [] as string[],
        imgSrc: [] as string[],
        connectSrc: [] as string[],
        frameSrc: [origin],
        formAction: [] as string[],
        fontSrc: [] as string[],
      };
    } catch {
      return {
        scriptSrc: [],
        styleSrc: [],
        imgSrc: [],
        connectSrc: [],
        frameSrc: [],
        formAction: [],
        fontSrc: [],
      };
    }
  }

  const origins = extractOrigins(widget.snippetHtml);
  return {
    scriptSrc: origins,
    styleSrc: origins,
    imgSrc: origins,
    connectSrc: origins,
    frameSrc: origins,
    formAction: origins,
    fontSrc: origins,
  };
}

function buildWidgetCsp(widget: MarkdownWidget) {
  const unique = (values: string[]) => [...new Set(values.filter(Boolean))];
  const join = (values: string[]) => unique(values).join(" ");
  const auto = getAutoOrigins(widget);

  return [
    "default-src 'none'",
    "base-uri 'none'",
    "object-src 'none'",
    "frame-ancestors 'self'",
    `script-src 'unsafe-inline' ${join(["'self'", ...auto.scriptSrc, ...widget.csp.scriptSrc])}`.trim(),
    `style-src 'unsafe-inline' ${join(["'self'", ...auto.styleSrc, ...widget.csp.styleSrc])}`.trim(),
    `img-src ${join(["'self'", "data:", "https:", ...auto.imgSrc, ...widget.csp.imgSrc])}`.trim(),
    `connect-src ${join(["'self'", ...auto.connectSrc, ...widget.csp.connectSrc])}`.trim(),
    `frame-src ${join(["'self'", ...auto.frameSrc, ...widget.csp.frameSrc])}`.trim(),
    `font-src ${join(["'self'", "data:", "https:", ...auto.fontSrc, ...widget.csp.fontSrc])}`.trim(),
    `form-action ${join(["'self'", ...auto.formAction, ...widget.csp.formAction])}`.trim(),
  ].join("; ");
}

const keyPattern = /^[a-z0-9-]+$/;
if (!key || !keyPattern.test(key)) {
  Astro.response.status = 404;
  Astro.response.headers.set("Content-Security-Policy", "default-src 'none'; frame-ancestors 'self'");
  Astro.response.headers.set("X-Frame-Options", "SAMEORIGIN");
  Astro.response.headers.set("Referrer-Policy", "strict-origin-when-cross-origin");
  Astro.response.headers.set("Permissions-Policy", "camera=(), microphone=(), geolocation=()");
  return Astro.rewrite("/404");
}

const apiUrl = new URL(`/api/v1/markdown-widgets/${encodeURIComponent(key)}`, Astro.url);
const response = await fetch(apiUrl);

if (!response.ok) {
  Astro.response.status = response.status === 404 ? 404 : 502;
  Astro.response.headers.set("Content-Security-Policy", "default-src 'none'; frame-ancestors 'self'");
  Astro.response.headers.set("X-Frame-Options", "SAMEORIGIN");
  Astro.response.headers.set("Referrer-Policy", "strict-origin-when-cross-origin");
  Astro.response.headers.set("Permissions-Policy", "camera=(), microphone=(), geolocation=()");
  return Astro.rewrite("/404");
}

const body = (await response.json()) as { data: MarkdownWidget };
const widget = body.data;
const iframeTitle = widget.label || "Markdown widget";

Astro.response.headers.set("Content-Security-Policy", buildWidgetCsp(widget));
Astro.response.headers.set("X-Frame-Options", "SAMEORIGIN");
Astro.response.headers.set("Referrer-Policy", "strict-origin-when-cross-origin");
Astro.response.headers.set("Permissions-Policy", "camera=(), microphone=(), geolocation=()");
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{widget.label}</title>
    <style>
      :root {
        color-scheme: light;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100%;
        background: transparent;
      }

      body {
        overflow: hidden;
      }

      iframe {
        display: block;
        width: 100%;
        min-height: 100vh;
        border: 0;
        background: transparent;
      }
    </style>
  </head>
  <body set:html={widget.type === "html" ? widget.snippetHtml : undefined}>
    {widget.type === "iframe" ? (
      <iframe
        src={widget.iframeUrl}
        title={iframeTitle}
        loading="lazy"
        allow="fullscreen"
        referrerpolicy="strict-origin-when-cross-origin"
      />
    ) : null}
  </body>
</html>
