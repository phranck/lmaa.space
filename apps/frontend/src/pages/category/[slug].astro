---
import ShopCard from "@/components/ShopCard.astro";
import ShopListItem from "@/components/ShopListItem.astro";
import ViewToggle from "@/components/ViewToggle.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { apiGet } from "@/lib/api";
import type { Shop } from "@lmaa/shared";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

interface CategoryPageView {
  name: string;
  imageUrl?: string | null;
  shops: Shop[];
}

function slugToTitle(value: string): string {
  return value
    .split("-")
    .filter(Boolean)
    .map((segment) => segment.charAt(0).toUpperCase() + segment.slice(1))
    .join(" ");
}

let category: CategoryPageView;
let isFallback = false;
try {
  const remote = await apiGet<{ name: string; imageUrl?: string | null; shops: Shop[] }>(
    `/categories/${slug}`,
  );
  category = {
    name: remote.name,
    imageUrl: remote.imageUrl ?? null,
    shops: remote.shops,
  };
} catch (err) {
  console.error(`[SSR] /category/${slug} fetch failed:`, err);
  isFallback = true;
  category = {
    name: slugToTitle(slug),
    imageUrl: null,
    shops: [],
  };
}

const shopCount = category.shops.length;
const site = Astro.site?.origin ?? "https://lmaa.space";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Start", item: `${site}/` },
    {
      "@type": "ListItem",
      position: 2,
      name: category.name,
      item: `${site}/category/${slug}`,
    },
  ],
};
---

<BaseLayout
  title={category.name}
  description={`${shopCount} ${shopCount === 1 ? "Shop" : "Shops"} in der Kategorie ${category.name} auf lmaa.space. Lokale Märkte. Alternative Anbieter.`}
  ogImage={category.imageUrl ?? undefined}
  jsonLd={jsonLd}
>
  <!-- Hero Banner -->
  <div class="relative h-52 sm:h-64 overflow-hidden">
    <img
      src={category.imageUrl ?? `/images/${slug}.jpg`}
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      class="w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-stone-900/65"></div>
    <div class="absolute inset-0 flex flex-col justify-end px-6 sm:px-10 pb-8">
      <h1 class="font-serif text-2xl sm:text-3xl font-semibold text-white">
        {category.name}
      </h1>
      <p class="text-stone-300 text-sm mt-1">
        {shopCount} {shopCount === 1 ? "Shop" : "Shops"} in dieser Kategorie
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-1.5 text-sm text-stone-400 mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-amber-700 transition-colors">Start</a>
      <span class="text-stone-300" aria-hidden="true">›</span>
      <span class="text-stone-600">{category.name}</span>
    </nav>

    {category.shops.length === 0 ? (
      <div class="text-center py-20 bg-stone-50 rounded-2xl border border-stone-100">
        {isFallback ? (
          <p class="text-stone-500">
            Kategorie-Inhalte sind gerade nicht erreichbar. Bitte in wenigen Minuten erneut laden.
          </p>
        ) : (
          <>
            <p class="text-stone-500 mb-5">Noch keine Shops in dieser Kategorie.</p>
            <a
              href="/suggestion"
              class="inline-block px-6 py-3 bg-stone-900 text-white rounded-xl text-sm font-medium hover:bg-amber-700 transition-colors"
              data-analytics-event="site-link-click"
              data-analytics-kind="cta"
              data-analytics-placement="category-empty-state"
              data-analytics-label="Ersten Shop vorschlagen"
              data-analytics-href="/suggestion"
            >
              Ersten Shop vorschlagen
            </a>
          </>
        )}
      </div>
    ) : (
      <>
        <!-- View toggle -->
        <div class="flex justify-end mb-4">
          <ViewToggle />
        </div>

        <!-- Shop listings container -->
        <div data-shop-view>
          <!-- Grid view -->
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4" data-view-grid>
            {category.shops.map((shop) => (
              <ShopCard shop={shop} detailHref={`/shop/${shop.id}?from=category&slug=${slug}`} />
            ))}
          </div>

          <!-- List view -->
          <div class="flex flex-col divide-y divide-stone-100 border border-stone-200 rounded-2xl overflow-hidden bg-white" data-view-list>
            {category.shops.map((shop) => (
              <ShopListItem shop={shop} detailHref={`/shop/${shop.id}?from=category&slug=${slug}`} />
            ))}
          </div>
        </div>
      </>
    )}
  </div>

  <script is:inline>
    (function () {
      var STORAGE_KEY = "lmaa-shop-view";
      var container = document.querySelector("[data-shop-view]");
      if (!container) return;

      var gridEl = container.querySelector("[data-view-grid]");
      var listEl = container.querySelector("[data-view-list]");
      if (!gridEl || !listEl) return;

      function applyView(view) {
        var isGrid = view === "grid";
        gridEl.style.display = isGrid ? "" : "none";
        listEl.style.display = isGrid ? "none" : "";

        var buttons = document.querySelectorAll("[data-view-toggle]");
        buttons.forEach(function (btn) {
          var isActive = btn.getAttribute("data-view-toggle") === view;
          btn.setAttribute("aria-checked", isActive ? "true" : "false");
          btn.style.backgroundColor = isActive ? "white" : "";
          btn.style.color = isActive ? "#1c1917" : "#a8a29e";
          btn.style.boxShadow = isActive ? "0 1px 2px rgba(0,0,0,0.06)" : "";
        });
      }

      var saved = "grid";
      try { saved = localStorage.getItem(STORAGE_KEY) || "grid"; } catch (e) {}
      if (saved !== "grid" && saved !== "list") saved = "grid";
      applyView(saved);

      document.addEventListener("click", function (e) {
        var btn = e.target.closest("[data-view-toggle]");
        if (!btn) return;
        var view = btn.getAttribute("data-view-toggle");
        if (view !== "grid" && view !== "list") return;
        applyView(view);
        try { localStorage.setItem(STORAGE_KEY, view); } catch (e) {}
      });
    })();
  </script>
</BaseLayout>
