---
import FilterableCategoryShops from "@/components/islands/FilterableCategoryShops";
import UnsplashAttribution from "@/components/UnsplashAttribution.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { apiGet } from "@/lib/api";
import { buildFilterQuery, parseFiltersFromUrl } from "@/lib/filter-query";
import { slugToTitle } from "@/lib/slug";
import type { Shop } from "@lmaa/shared";

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

interface CategoryPageView {
  name: string;
  imageUrl?: string | null;
  imagePhotographer?: string | null;
  imagePhotographerUrl?: string | null;
  imageFocalPointY?: number;
  shops: Shop[];
}

const filters = parseFiltersFromUrl(Astro.url);
const filterQuery = buildFilterQuery(filters);
const hasFilters = filterQuery.length > 0;

let category: CategoryPageView;
let isFallback = false;
try {
  const endpoint = hasFilters
    ? `/filtered/categories/${slug}?${filterQuery}`
    : `/categories/${slug}`;
  const remote = await apiGet<{ name: string; imageUrl?: string | null; imagePhotographer?: string | null; imagePhotographerUrl?: string | null; imageFocalPointY?: number; shops: Shop[] }>(
    endpoint,
  );
  category = {
    name: remote.name,
    imageUrl: remote.imageUrl ?? null,
    imagePhotographer: remote.imagePhotographer ?? null,
    imagePhotographerUrl: remote.imagePhotographerUrl ?? null,
    imageFocalPointY: remote.imageFocalPointY ?? 50,
    shops: remote.shops,
  };
} catch (err) {
  console.error(`[SSR] /category/${slug} fetch failed:`, err);
  isFallback = true;
  category = {
    name: slugToTitle(slug),
    imageUrl: null,
    shops: [],
  };
}

const shopCount = category.shops.length;
const site = Astro.site?.origin ?? "https://lmaa.space";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Start", item: `${site}/` },
    {
      "@type": "ListItem",
      position: 2,
      name: category.name,
      item: `${site}/category/${slug}`,
    },
  ],
};
---

<BaseLayout
  title={category.name}
  description={`${shopCount} ${shopCount === 1 ? "Shop" : "Shops"} in der Kategorie ${category.name} auf lmaa.space. Lokale Märkte. Alternative Anbieter.`}
  ogImage={category.imageUrl ?? undefined}
  jsonLd={jsonLd}
>
  <!-- Hero Banner -->
  <div class="relative h-52 sm:h-64 overflow-hidden">
    <img
      src={category.imageUrl ?? `/images/${slug}.jpg`}
      alt=""
      aria-hidden="true"
      fetchpriority="high"
      class="w-full h-full object-cover"
      style={`object-position: 50% ${category.imageFocalPointY ?? 50}%`}
    />
    <div class="absolute inset-0 bg-stone-900/65"></div>
    {category.imagePhotographer && category.imagePhotographerUrl && (
      <UnsplashAttribution
        photographer={category.imagePhotographer}
        photographerUrl={category.imagePhotographerUrl}
        class="z-10"
      />
    )}
    <div class="absolute inset-0 flex flex-col justify-end px-6 sm:px-10 pb-8">
      <h1 class="font-serif text-2xl sm:text-3xl font-semibold text-white">
        {category.name}
      </h1>
      <p class="text-stone-300 text-sm mt-1">
        {shopCount} {shopCount === 1 ? "Shop" : "Shops"} in dieser Kategorie
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {isFallback ? (
      <div class="text-center py-20 bg-stone-50 rounded-2xl border border-stone-100">
        <p class="text-stone-700">
          Kategorie-Inhalte sind gerade nicht erreichbar. Bitte in wenigen Minuten erneut laden.
        </p>
      </div>
    ) : (
      <FilterableCategoryShops
        client:idle
        slug={slug}
        categoryName={category.name}
        shops={category.shops}
        initialFilters={filters}
      />
    )}
  </div>

</BaseLayout>
