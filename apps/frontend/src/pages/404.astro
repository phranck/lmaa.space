---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Seite nicht gefunden" noindex={true}>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-24 text-center">
    <p
      class="text-6xl font-serif font-semibold text-[var(--ds-border)] mb-4 select-none"
      aria-hidden="true"
    >
      404
    </p>
    <h1 class="font-serif text-2xl font-semibold text-[var(--ds-text)] mb-3">
      Seite nicht gefunden
    </h1>
    <p class="text-[var(--ds-text-muted)] mb-10 leading-relaxed">
      Diese Seite existiert nicht oder wurde verschoben.
    </p>
    <a
      href="/"
      class="inline-flex items-center justify-center h-9 px-6 bg-[var(--ds-btn-filled-bg)] text-[var(--ds-btn-filled-fg)] rounded-lg text-sm font-medium hover:bg-[var(--ds-btn-filled-hover)] transition-colors"
    >
      Zur Startseite
    </a>
  </div>
</BaseLayout>
