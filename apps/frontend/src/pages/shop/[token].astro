---
import SectionLabel from "@/components/SectionLabel.astro";
import ShopAvatar from "@/components/ShopAvatar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { apiGet } from "@/lib/api";
import { renderMarkdown } from "@/lib/markdown";
import { shopDomain, shopRefUrl } from "@/lib/shop";
import { slugToTitle } from "@/lib/slug";
import { type Shop, encodeShopToken } from "@lmaa/shared";
import { SocialMediaIcons } from "@lmaa/ui";
import {
  ArrowLeftIcon,
  MapPinIcon,
  PackageIcon,
  StorefrontIcon,
  TagIcon,
} from "@phosphor-icons/react";

const { token } = Astro.params;

if (!token || !/^[a-z0-9]+$/.test(token)) {
  return Astro.redirect("/404");
}

let shop: Shop;
try {
  shop = await apiGet<Shop>(`/shops/${token}`);
} catch {
  return Astro.redirect("/404");
}

const shopToken = encodeShopToken(shop.id);

const domain = shopDomain(shop.url);
const visitUrl = shopRefUrl(shop.url);
const descriptionHtml = shop.description ? await renderMarkdown(shop.description) : null;

// Breadcrumb: flat, max 3 levels
const from = Astro.url.searchParams.get("from");
const fromSlug = Astro.url.searchParams.get("slug");
const fromQuery = Astro.url.searchParams.get("q");

// Category hero image (when navigating from a category page)
let categoryImageUrl: string | null = null;
if (from === "category" && fromSlug) {
  try {
    const cat = await apiGet<{ imageUrl?: string | null }>(`/categories/${fromSlug}`);
    categoryImageUrl = cat.imageUrl ?? null;
  } catch {
    // ignore — no hero banner
  }
}

interface BreadcrumbItem {
  label: string;
  href: string;
}

const breadcrumb: BreadcrumbItem[] = [{ label: "Start", href: "/" }];
let backHref = "/";

if (from === "category" && fromSlug) {
  const matchedCategory = shop.categories.find((c) => c.slug === fromSlug);
  const categoryLabel = matchedCategory
    ? matchedCategory.name
    : slugToTitle(fromSlug);
  const categoryHref = `/category/${fromSlug}`;
  breadcrumb.push({ label: categoryLabel, href: categoryHref });
  backHref = categoryHref;
} else if (from === "search" && fromQuery) {
  const searchHref = `/search?q=${encodeURIComponent(fromQuery)}`;
  breadcrumb.push({ label: `Suche: "${fromQuery}"`, href: searchHref });
  backHref = searchHref;
}

// Dialog IDs
const deadDialogId = `dialog-dead-${shop.id}`;
const reportDialogId = `dialog-report-${shop.id}`;

// HQ
const hq = shop.headquarters;
const hasHq = hq && (hq.street || hq.city || hq.state || hq.countryCode);
const hqParts: string[] = [];
if (hq) {
  if (hq.street) hqParts.push(hq.street);
  const cityLine = [hq.postalCode, hq.city].filter(Boolean).join(" ");
  if (cityLine) hqParts.push(cityLine);
  if (hq.state) hqParts.push(hq.state);
  if (hq.countryCode) hqParts.push(hq.countryCode);
}

// Notes
const notes = shop.shopCheckNotes;
const hasFocus = notes?.focus && notes.focus.length > 0;
const hasBrands = notes?.brandsOrProducts && notes.brandsOrProducts.length > 0;
const hasNotes = hasFocus || hasBrands;

// SEO
const site = Astro.site?.origin ?? "https://lmaa.space";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Start", item: `${site}/` },
    ...(breadcrumb.length > 1
      ? [
          {
            "@type": "ListItem",
            position: 2,
            name: breadcrumb[1].label,
            item: `${site}${breadcrumb[1].href}`,
          },
        ]
      : []),
    {
      "@type": "ListItem",
      position: breadcrumb.length + 1,
      name: shop.name,
      item: `${site}/shop/${shopToken}`,
    },
  ],
};

const metaDescription = shop.description
  ? shop.description.replace(/\s+/g, " ").trim().slice(0, 160)
  : `${shop.name} auf lmaa.space. Lokale Märkte. Alternative Anbieter.`;
---

<BaseLayout
  title={shop.name}
  description={metaDescription}
  ogImage={shop.ogImage ?? undefined}
  jsonLd={jsonLd}
>
  <!-- Hero Banner (category context) -->
  {categoryImageUrl && (
    <div class="relative h-52 sm:h-64 overflow-hidden">
      <img
        src={categoryImageUrl}
        alt=""
        aria-hidden="true"
        fetchpriority="high"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-stone-900/65"></div>
    </div>
  )}

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10">

    <!-- Breadcrumb with back button -->
    <nav class="flex items-center gap-3 mb-8" aria-label="Breadcrumb">
      <a
        href={backHref}
        class="shrink-0 w-8 h-8 flex items-center justify-center rounded-lg text-stone-400 hover:text-stone-600 hover:bg-stone-100 transition-colors"
        aria-label="Zurück"
      >
        <ArrowLeftIcon weight="bold" className="w-4 h-4" />
      </a>
      <ol class="flex items-center gap-1.5 text-sm text-stone-400 min-w-0">
        {breadcrumb.map((item, i) => (
          <li class="flex items-center gap-1.5 min-w-0">
            {i > 0 && <span class="text-stone-300 shrink-0" aria-hidden="true">›</span>}
            <a href={item.href} class="hover:text-amber-700 transition-colors truncate">{item.label}</a>
          </li>
        ))}
        <li class="flex items-center gap-1.5 min-w-0">
          <span class="text-stone-300 shrink-0" aria-hidden="true">›</span>
          <span class="text-stone-600 truncate">{shop.name}</span>
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="flex flex-col sm:flex-row items-start gap-5 mb-8">
      <ShopAvatar name={shop.name} imageUrl={shop.ogImage} size="md" />
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-start gap-3">
          <div class="min-w-0 flex-1">
            <h1 class="font-serif text-2xl sm:text-3xl font-semibold text-stone-900 leading-tight">
              {shop.name}
            </h1>
            <a
              href={visitUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-stone-400 hover:text-amber-700 transition-colors mt-1 inline-block"
            >
              {domain}
            </a>
            <SocialMediaIcons socialMedia={shop.socialMedia} />
          </div>
          {hasHq && (
            <address class="text-sm text-stone-500 not-italic leading-relaxed shrink-0 text-right">
              {hqParts.map((part, i) => (
                <Fragment>
                  {i > 0 && <br />}
                  {part}
                </Fragment>
              ))}
            </address>
          )}
        </div>
      </div>
    </header>

    <!-- Description -->
    {descriptionHtml && (
      <section class="mb-8">
        <div
          class="text-sm sm:text-base text-stone-600 leading-relaxed prose prose-stone max-w-none prose-p:my-3 prose-a:text-amber-700 prose-headings:font-serif"
          set:html={descriptionHtml}
        />
      </section>
    )}

    <!-- Info grid -->
    <div class="grid sm:grid-cols-2 gap-4 mb-8">
      {shop.shipping && (
        <div class="flex items-start gap-3 p-4 rounded-2xl bg-stone-50 border border-stone-100">
          <PackageIcon weight="duotone" className="w-5 h-5 text-stone-400 shrink-0 mt-0.5" />
          <div>
            <p class="text-xs font-medium text-stone-400 uppercase tracking-wide mb-1">Versand</p>
            <p class="text-sm text-stone-700">{shop.shipping}</p>
          </div>
        </div>
      )}

      {shop.pickup && (
        <div class="flex items-start gap-3 p-4 rounded-2xl bg-stone-50 border border-stone-100">
          <StorefrontIcon weight="duotone" className="w-5 h-5 text-stone-400 shrink-0 mt-0.5" />
          <div>
            <p class="text-xs font-medium text-stone-400 uppercase tracking-wide mb-1">Abholung</p>
            <p class="text-sm text-stone-700">{shop.pickup}</p>
          </div>
        </div>
      )}
    </div>

    <!-- Categories -->
    {shop.categories?.length > 0 && (
      <section class="mb-8">
        <SectionLabel class="mb-3">Kategorien</SectionLabel>
        <div class="flex flex-wrap gap-2">
          {shop.categories.map((cat) => (
            <a
              href={`/category/${cat.slug}`}
              class="px-3 py-1.5 rounded-full text-sm font-medium bg-amber-50 text-amber-700/70 hover:bg-amber-100 hover:text-amber-700 transition-colors"
              data-analytics-event="category-click"
              data-analytics-source="shop-detail"
              data-category-id={String(cat.id)}
              data-category-slug={cat.slug}
              data-category-name={cat.name}
            >
              {cat.name}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Notes: focus + brands -->
    {hasNotes && (
      <section class="mb-8 space-y-5">
        {hasFocus && (
          <div>
            <SectionLabel class="mb-3 flex items-center gap-2">
              <TagIcon weight="duotone" className="w-4 h-4" />
              Schwerpunkte
            </SectionLabel>
            <div class="flex flex-wrap gap-2">
              {notes!.focus.map((tag) => (
                <span class="px-3 py-1.5 rounded-full text-sm bg-stone-100 text-stone-600 border border-stone-200">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}

        {hasBrands && (
          <div>
            <SectionLabel class="mb-3 flex items-center gap-2">
              <TagIcon weight="duotone" className="w-4 h-4" />
              Marken & Produkte
            </SectionLabel>
            <div class="flex flex-wrap gap-2">
              {notes!.brandsOrProducts.map((tag) => (
                <span class="px-3 py-1.5 rounded-full text-sm bg-stone-100 text-stone-600 border border-stone-200">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}
      </section>
    )}

    <!-- Standort (Map) -->
    {hq?.latitude != null && hq?.longitude != null && (
      <section class="mb-8">
        <SectionLabel class="mb-3 flex items-center gap-2">
          <MapPinIcon weight="duotone" className="w-4 h-4" />
          Standort
        </SectionLabel>
        <div
          id="shop-map"
          class="rounded-2xl overflow-hidden border border-stone-100"
          style="height:400px"
          data-lat={String(hq.latitude)}
          data-lng={String(hq.longitude)}
          data-name={shop.name}
        ></div>
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <style>
          .leaflet-bar {
            border: none !important;
            border-radius: 10px !important;
            overflow: hidden !important;
            box-shadow: none !important;
          }
          .leaflet-bar a,
          .leaflet-bar a:hover {
            background-color: rgba(0, 0, 0, 0.4) !important;
            color: #fff !important;
            border: none !important;
          }
          .leaflet-bar a:hover {
            background-color: rgba(0, 0, 0, 0.6) !important;
          }
          .map-layer-switcher {
            position: absolute;
            top: 12px;
            right: 12px;
            z-index: 1000;
            display: flex;
            align-items: flex-start;
            gap: 6px;
          }
          .map-layer-toggle {
            width: 34px;
            height: 34px;
            border-radius: 10px;
            border: none;
            background-color: rgba(0, 0, 0, 0.4);
            color: #fff;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            transition: background-color 0.15s;
            flex-shrink: 0;
          }
          .map-layer-toggle:hover {
            background-color: rgba(0, 0, 0, 0.6);
          }
          .map-layer-panel {
            display: flex;
            gap: 6px;
            overflow: hidden;
            max-width: 0;
            opacity: 0;
            transition: max-width 0.3s ease, opacity 0.25s ease;
          }
          .map-layer-panel.open {
            max-width: 280px;
            opacity: 1;
          }
          .map-layer-btn {
            width: 56px;
            height: 56px;
            border-radius: 10px;
            border: 2px solid transparent;
            overflow: hidden;
            cursor: pointer;
            position: relative;
            box-shadow: 0 2px 8px rgba(0,0,0,0.3);
            transition: border-color 0.15s, transform 0.15s;
            flex-shrink: 0;
            padding: 0;
            background: none;
          }
          .map-layer-btn:hover {
            transform: scale(1.05);
          }
          .map-layer-btn.active {
            border-color: #fff;
          }
          .map-layer-btn img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
          }
          .map-layer-btn span {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            font-size: 9px;
            font-weight: 600;
            text-align: center;
            color: #fff;
            background: rgba(0,0,0,0.55);
            padding: 2px 0;
            line-height: 1.2;
          }
          .leaflet-control-attribution {
            background-color: rgba(0, 0, 0, 0.35) !important;
            color: rgba(255, 255, 255, 0.8) !important;
          }
          .leaflet-control-attribution a {
            color: rgba(255, 255, 255, 0.9) !important;
          }
        </style>
        <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script is:inline>
          (function () {
            var el = document.getElementById("shop-map");
            var lat = parseFloat(el.dataset.lat);
            var lng = parseFloat(el.dataset.lng);
            var name = el.dataset.name;

            var STORAGE_KEY = "lmaa-map-prefs";
            var prefs = {};
            try { prefs = JSON.parse(localStorage.getItem(STORAGE_KEY)) || {}; } catch {}
            var savedZoom = typeof prefs.zoom === "number" ? prefs.zoom : 15;
            var savedLayer = prefs.layer || "osm";

            function savePrefs() {
              localStorage.setItem(STORAGE_KEY, JSON.stringify({ zoom: map.getZoom(), layer: activeId }));
            }

            var map = L.map(el, { zoomControl: true }).setView([lat, lng], savedZoom);

            var layers = [
              {
                id: "osm",
                label: "Karte",
                tile: L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
                  attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                  maxZoom: 19,
                }),
                thumb: "https://a.tile.openstreetmap.org/12/2135/1407.png",
              },
              {
                id: "satellite",
                label: "Satellit",
                tile: L.tileLayer(
                  "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                  { attribution: '&copy; <a href="https://www.esri.com/">Esri</a>', maxZoom: 19 }
                ),
                thumb: "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/12/1407/2135",
              },
              {
                id: "topo",
                label: "Topo",
                tile: L.tileLayer("https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png", {
                  attribution: '&copy; <a href="https://opentopomap.org">OpenTopoMap</a>',
                  maxZoom: 17,
                }),
                thumb: "https://a.tile.opentopomap.org/12/2135/1407.png",
              },
              {
                id: "hot",
                label: "HOT",
                tile: L.tileLayer("https://{s}.tile.openstreetmap.fr/hot/{z}/{x}/{y}.png", {
                  attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://hot.openstreetmap.org/">HOT</a>',
                  maxZoom: 19,
                }),
                thumb: "https://a.tile.openstreetmap.fr/hot/12/2135/1407.png",
              },
            ];

            var initialLayer = layers.find(function (l) { return l.id === savedLayer; }) || layers[0];
            var activeId = initialLayer.id;
            initialLayer.tile.addTo(map);
            L.marker([lat, lng]).addTo(map).bindPopup(name);

            map.on("zoomend", savePrefs);

            // Custom layer switcher
            var switcher = document.createElement("div");
            switcher.className = "map-layer-switcher";
            L.DomEvent.disableClickPropagation(switcher);

            var toggle = document.createElement("button");
            toggle.className = "map-layer-toggle";
            toggle.type = "button";
            toggle.title = "Kartenstil";
            toggle.setAttribute("aria-label", "Kartenstil wechseln");
            toggle.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 256 256" fill="currentColor" style="margin-top:-3px"><path d="M230.91 124 128 180.07 25.09 124a8 8 0 0 0-10.18 12l104 56a8 8 0 0 0 7.58 0l104-56a8 8 0 0 0-10.18-12ZM128 236.07 25.09 180a8 8 0 1 0-7.58 14.12l104 56a8 8 0 0 0 7.58 0l104-56a8 8 0 0 0-7.58-14.12Zm-99.49-128 104-56a8 8 0 0 1 7.58 0l104 56a8 8 0 0 1 0 14.12l-104 56a8 8 0 0 1-7.58 0l-104-56a8 8 0 0 1 0-14.12Z"/></svg>';

            var panel = document.createElement("div");
            panel.className = "map-layer-panel";

            layers.forEach(function (layer) {
              var btn = document.createElement("button");
              btn.className = "map-layer-btn" + (layer.id === activeId ? " active" : "");
              btn.title = layer.label;
              btn.type = "button";
              btn.innerHTML = '<img src="' + layer.thumb + '" alt="' + layer.label + '"><span>' + layer.label + "</span>";
              btn.addEventListener("click", function () {
                startAutoClose();
                if (activeId === layer.id) return;
                layers.forEach(function (l) { map.removeLayer(l.tile); });
                layer.tile.addTo(map);
                activeId = layer.id;
                panel.querySelectorAll(".map-layer-btn").forEach(function (b) { b.classList.remove("active"); });
                btn.classList.add("active");
                savePrefs();
              });
              panel.appendChild(btn);
            });

            var autoCloseTimer = null;
            function startAutoClose() {
              clearTimeout(autoCloseTimer);
              autoCloseTimer = setTimeout(function () { panel.classList.remove("open"); }, 5000);
            }

            toggle.addEventListener("click", function () {
              var opening = !panel.classList.contains("open");
              panel.classList.toggle("open");
              clearTimeout(autoCloseTimer);
              if (opening) startAutoClose();
            });

            switcher.appendChild(panel);
            switcher.appendChild(toggle);
            el.appendChild(switcher);

            // Fullscreen control
            var FullscreenControl = L.Control.extend({
              options: { position: "topleft" },
              onAdd: function () {
                var btn = L.DomUtil.create("div", "leaflet-bar leaflet-control");
                var a = L.DomUtil.create("a", "", btn);
                a.href = "#";
                a.title = "Vollbild";
                a.setAttribute("role", "button");
                a.setAttribute("aria-label", "Vollbild");
                a.innerHTML = "⛶";
                a.style.cssText = "display:flex;align-items:center;justify-content:center;width:30px;height:30px;font-size:18px;line-height:1;text-decoration:none;color:#fff";
                L.DomEvent.disableClickPropagation(btn);
                L.DomEvent.on(a, "click", function (e) {
                  L.DomEvent.preventDefault(e);
                  if (!document.fullscreenElement) {
                    el.requestFullscreen();
                  } else {
                    document.exitFullscreen();
                  }
                });
                return btn;
              },
            });
            new FullscreenControl().addTo(map);

            el.addEventListener("fullscreenchange", function () {
              setTimeout(function () { map.invalidateSize(); }, 100);
            });
          })();
        </script>
        <a
          href={`https://www.openstreetmap.org/directions?to=${hq.latitude},${hq.longitude}#map=15/${hq.latitude}/${hq.longitude}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm text-stone-400 hover:text-amber-700 transition-colors mt-2"
        >
          Route planen ↗
        </a>
      </section>
    )}

    <!-- Actions footer -->
    <footer class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-4 pt-6 border-t border-stone-200" data-shop-id={shop.id}>
      <div class="flex items-center gap-4" data-shop-actions>
        <button
          type="button"
          class="text-sm text-stone-400 hover:text-red-400 transition-colors"
          data-action="dead-link"
          data-shop-id={shop.id}
          data-dialog={deadDialogId}
          aria-label={`Defekten Link für ${shop.name} melden`}
        >
          Link defekt?
        </button>
        <button
          type="button"
          class="text-sm text-stone-400 hover:text-red-400 transition-colors"
          data-action="report"
          data-shop-id={shop.id}
          data-dialog={reportDialogId}
          aria-label={`${shop.name} melden`}
        >
          Shop melden
        </button>
      </div>
      <a
        href={visitUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-6 py-2.5 rounded-xl text-sm font-medium transition-colors bg-[var(--accent-hover)] text-[var(--accent-text)] hover:bg-[var(--accent-active)]"
        data-analytics-event="shop-visit-click"
        data-analytics-source="shop-detail"
        data-shop-id={String(shop.id)}
        data-shop-name={shop.name}
        data-shop-domain={domain}
      >
        Shop besuchen ↗
      </a>
    </footer>
  </div>

  <!-- Dead link confirmation dialog -->
  <dialog
    id={deadDialogId}
    aria-labelledby={`${deadDialogId}-title`}
    aria-describedby={`${deadDialogId}-desc`}
    aria-modal="true"
    class="bg-[var(--ds-surface)] rounded-[var(--ds-radius-3xl)] shadow-[var(--ds-shadow-xl)] w-full max-w-md p-6 m-auto"
  >
    <h2 id={`${deadDialogId}-title`} class="font-serif text-xl font-semibold text-[var(--ds-text)] mb-1">
      Link defekt?
    </h2>
    <p id={`${deadDialogId}-desc`} class="text-sm text-[var(--ds-text-muted)] mb-6">
      Ist der Link von <span class="font-medium text-[var(--ds-text)]">{shop.name}</span> wirklich nicht mehr erreichbar?
    </p>
    <div class="flex gap-3 justify-end">
      <button
        type="button"
        class="h-9 px-4 text-sm text-[var(--ds-text-muted)] hover:text-[var(--ds-text)] transition-colors"
        data-dismiss
      >
        Abbrechen
      </button>
      <button
        type="button"
        class="h-9 px-5 bg-[var(--ds-btn-filled-bg)] text-[var(--ds-btn-filled-fg)] rounded-control text-sm font-medium hover:bg-[var(--ds-btn-filled-hover)] transition-colors"
        data-confirm="dead-link"
        data-shop-id={shop.id}
      >
        Ja, Link melden
      </button>
    </div>
  </dialog>

  <!-- Report/concern dialog -->
  <dialog
    id={reportDialogId}
    aria-labelledby={`${reportDialogId}-title`}
    aria-describedby={`${reportDialogId}-desc`}
    aria-modal="true"
    class="bg-[var(--ds-surface)] rounded-[var(--ds-radius-3xl)] shadow-[var(--ds-shadow-xl)] w-full max-w-md p-6 m-auto"
  >
    <div data-report-form>
      <h2 id={`${reportDialogId}-title`} class="font-serif text-xl font-semibold text-[var(--ds-text)] mb-1">
        Shop melden
      </h2>
      <p id={`${reportDialogId}-desc`} class="text-sm text-[var(--ds-text-muted)] mb-5">
        Du möchtest <span class="font-medium text-[var(--ds-text)]">{shop.name}</span> melden? Beschreibe kurz, warum dieser Shop deiner Meinung nach nicht auf lmaa.space gehört.
      </p>
      <div class="space-y-4">
        <textarea
          rows="4"
          placeholder="z. B. Shop verkauft keine fairen oder nachhaltigen Produkte, ist nicht mehr erreichbar, …"
          class="w-full px-3 py-2.5 border border-[var(--ds-border)] rounded-control text-sm bg-[var(--ds-input-bg)] text-[var(--ds-text)] placeholder:text-[var(--ds-text-subtle)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] resize-none"
          data-reason-input
        ></textarea>
        <p class="text-[var(--ds-danger-text)] text-xs hidden" data-error-msg></p>
        <div class="flex gap-3 justify-end">
          <button
            type="button"
            class="h-9 px-4 text-sm text-[var(--ds-text-muted)] hover:text-[var(--ds-text)] transition-colors"
            data-dismiss
          >
            Abbrechen
          </button>
          <button
            type="button"
            class="h-9 px-5 bg-[var(--ds-btn-filled-bg)] text-[var(--ds-btn-filled-fg)] rounded-control text-sm font-medium hover:bg-[var(--ds-btn-filled-hover)] transition-colors disabled:opacity-50"
            data-confirm="report"
            data-shop-id={shop.id}
          >
            Melden
          </button>
        </div>
      </div>
    </div>
    <div data-report-success class="text-center py-6 hidden">
      <p class="text-2xl mb-3">🙏</p>
      <h2 class="font-serif text-xl font-semibold text-[var(--ds-text)] mb-2">
        Danke für deinen Hinweis!
      </h2>
      <p class="text-sm text-[var(--ds-text-muted)] mb-6">
        Wir prüfen deine Meldung und handeln bei Bedarf.
      </p>
      <button
        type="button"
        class="h-9 px-6 bg-[var(--ds-btn-filled-bg)] text-[var(--ds-btn-filled-fg)] rounded-control text-sm font-medium hover:bg-[var(--ds-btn-filled-hover)] transition-colors"
        data-dismiss
      >
        Schließen
      </button>
    </div>
  </dialog>
</BaseLayout>
