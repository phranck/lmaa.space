---
import SupportPromptSlot from "@/components/islands/SupportPromptSlot";
import SectionLabel from "@/components/SectionLabel.astro";
import ShopAvatar from "@/components/ShopAvatar.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { apiGet } from "@/lib/api";
import { stripMarkdown } from "@/lib/markdown";
import { renderMarkdownSSR as renderMarkdown } from "@/lib/markdown-ssr";
import { shopDomain, shopRefUrl } from "@/lib/shop";
import { slugToTitle } from "@/lib/slug";
import { loadSupportPrompts } from "@/lib/support-prompts";
import { countryName, encodeShopToken, type Shop } from "@lmaa/shared";
import { PaymentMethodIcons, SocialMediaIcons } from "@lmaa/ui";
import { getFavicons } from "@/lib/favicons";
import { ShopLocationMap } from "@lmaa/ui/shop-location-map";
import {
  ArrowLeftIcon,
  ArrowSquareOutIcon,
  CreditCardIcon,
  HeartIcon,
  MapPinIcon,
  PackageIcon,
  ShareNetworkIcon,
  StorefrontIcon,
} from "@phosphor-icons/react";

const { token } = Astro.params;

if (!token || !/^[a-z0-9]+$/.test(token)) {
  return Astro.redirect("/404");
}

// Breadcrumb: flat, max 3 levels
const from = Astro.url.searchParams.get("from");
const fromSlug = Astro.url.searchParams.get("slug");
const fromQuery = Astro.url.searchParams.get("q");

// Fetch shop + category image in parallel when navigating from a category page
const shopPromise = apiGet<Shop>(`/shops/${token}`);
const categoryFromSlugPromise = (from === "category" && fromSlug)
  ? apiGet<{ imageUrl?: string | null }>(`/categories/${fromSlug}`).catch(() => null)
  : Promise.resolve(null);

let shop: Shop;
try {
  [shop] = await Promise.all([shopPromise, categoryFromSlugPromise]);
} catch {
  return Astro.redirect("/404");
}

const categoryFromSlugResult = await categoryFromSlugPromise;

const shopToken = encodeShopToken(shop.id);

const domain = shopDomain(shop.url);
const visitUrl = shopRefUrl(shop.url);
const descriptionHtml = shop.description ? await renderMarkdown(shop.description) : null;
const supportPrompts = await loadSupportPrompts("shop-detail");
const favicons = await getFavicons(shop.socialMedia);

// Category hero image (when navigating from a category page)
let categoryImageUrl: string | null = categoryFromSlugResult?.imageUrl ?? null;

// Fallback: use first category's banner when not coming from a category page
if (!categoryImageUrl && shop.categories.length > 0) {
  try {
    const cat = await apiGet<{ imageUrl?: string | null }>(`/categories/${shop.categories[0].slug}`);
    categoryImageUrl = cat.imageUrl ?? null;
  } catch {
    // ignore — no hero banner
  }
}

interface BreadcrumbItem {
  label: string;
  href: string;
}

const breadcrumb: BreadcrumbItem[] = [{ label: "Start", href: "/" }];
let backHref = "/";

if (from === "category" && fromSlug) {
  const matchedCategory = shop.categories.find((c) => c.slug === fromSlug);
  const categoryLabel = matchedCategory
    ? matchedCategory.name
    : slugToTitle(fromSlug);
  const categoryHref = `/category/${fromSlug}`;
  breadcrumb.push({ label: categoryLabel, href: categoryHref });
  backHref = categoryHref;
} else if (from === "search" && fromQuery) {
  const searchHref = `/search?q=${encodeURIComponent(fromQuery)}`;
  breadcrumb.push({ label: `Suche: "${fromQuery}"`, href: searchHref });
  backHref = searchHref;
}

// Dialog IDs
const deadDialogId = `dialog-dead-${shop.id}`;
const reportDialogId = `dialog-report-${shop.id}`;

// HQ
const hq = shop.headquarters;
const hasHq = hq && (hq.street || hq.city || hq.state || hq.countryCode);
/** Whether a map stands above the actions, which is what the inset answers to. */
const hasMap = hq?.latitude != null && hq?.longitude != null;
const hqParts: string[] = [];
if (hq) {
  if (hq.street) hqParts.push(hq.street);
  const cityLine = [hq.postalCode, hq.city].filter(Boolean).join(" ");
  if (cityLine) hqParts.push(cityLine);
  if (hq.state) hqParts.push(hq.state);
  if (hq.countryCode) hqParts.push(countryName(hq.countryCode));
}

// SEO
const site = Astro.site?.origin ?? "https://lmaa.space";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Start", item: `${site}/` },
    ...(breadcrumb.length > 1
      ? [
          {
            "@type": "ListItem",
            position: 2,
            name: breadcrumb[1].label,
            item: `${site}${breadcrumb[1].href}`,
          },
        ]
      : []),
    {
      "@type": "ListItem",
      position: breadcrumb.length + 1,
      name: shop.name,
      item: `${site}/shop/${shopToken}`,
    },
  ],
};

const metaDescription = shop.description
  ? stripMarkdown(shop.description).slice(0, 160)
  : `${shop.name} auf lmaa.space. Lokale Märkte. Alternative Anbieter.`;
---

<BaseLayout
  title={shop.name}
  description={metaDescription}
  ogImage={shop.ogImage ?? undefined}
  jsonLd={jsonLd}
>
  <!-- Hero Banner (category context) -->
  {categoryImageUrl && (
    <div class="relative h-52 sm:h-64 overflow-hidden">
      <img
        src={categoryImageUrl}
        alt=""
        aria-hidden="true"
        fetchpriority="high"
        width={1920}
        height={256}
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-stone-900/65"></div>
    </div>
  )}

  <!-- The map's radius stands once here. What sits under the map steps in by
       half of it, because a line set hard against a rounded corner reads as
       colliding with it. -->
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10" style="--map-radius: 1rem">

    <!-- Breadcrumb with back button -->
    <nav class="flex items-center gap-3 mb-8" aria-label="Breadcrumb">
      <a
        href={backHref}
        class="shrink-0 w-8 h-8 flex items-center justify-center rounded-lg text-stone-600 hover:text-stone-800 hover:bg-stone-100 transition-colors"
        aria-label="Zurück"
      >
        <ArrowLeftIcon weight="bold" className="w-4 h-4" />
      </a>
      <ol class="flex items-center gap-1.5 text-sm text-stone-600 min-w-0">
        {breadcrumb.map((item, i) => (
          <li class="flex items-center gap-1.5 min-w-0">
            {i > 0 && <span class="text-stone-300 shrink-0" aria-hidden="true">›</span>}
            <a href={item.href} class="hover:text-amber-700 transition-colors truncate">{item.label}</a>
          </li>
        ))}
        <li class="flex items-center gap-1.5 min-w-0">
          <span class="text-stone-300 shrink-0" aria-hidden="true">›</span>
          <span class="text-stone-600 truncate">{shop.name}</span>
        </li>
      </ol>
    </nav>

    <!-- Header -->
    <header class="flex flex-row items-start gap-5 mb-8">
      <a
        href={visitUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 rounded-2xl transition-opacity hover:opacity-80"
        tabindex="-1"
        aria-hidden="true"
        data-analytics-event="shop-visit-click"
        data-analytics-source="shop-detail-logo"
        data-shop-id={String(shop.id)}
        data-shop-name={shop.name}
        data-shop-domain={domain}
      >
        <ShopAvatar name={shop.name} imageUrl={shop.ogImage} logoBackgroundColor={shop.logoBackgroundColor} size="md" />
      </a>
      <div class="flex-1 min-w-0">
        <div class="flex flex-wrap items-start gap-3">
          <div class="min-w-0 flex-1">
            <h1 class="font-serif text-2xl sm:text-3xl font-semibold text-stone-900 leading-tight">
              <a
                href={visitUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-amber-700"
                data-analytics-event="shop-visit-click"
                data-analytics-source="shop-detail-name"
                data-shop-id={String(shop.id)}
                data-shop-name={shop.name}
                data-shop-domain={domain}
              >
                {shop.name}
              </a>
            </h1>
            <a
              href={visitUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-stone-600 hover:text-amber-700 transition-colors mt-1 inline-block"
            >
              {domain}
            </a>
            <SocialMediaIcons socialMedia={shop.socialMedia} favicons={favicons} />
          </div>
          <div class="flex items-stretch gap-3 shrink-0">
            {hasHq && (
              <Fragment>
                <address class="hidden sm:block text-sm text-stone-700 not-italic leading-relaxed text-right">
                  {hqParts.map((part, i) => (
                    <Fragment>
                      {i > 0 && <br />}
                      {part}
                    </Fragment>
                  ))}
                </address>
                <div class="hidden sm:block w-px bg-stone-200" aria-hidden="true" />
              </Fragment>
            )}
            <div class="flex flex-col items-center gap-1">
              {shop.likeCount > 0 && (
                <span
                  class="text-xs text-stone-400 tabular-nums leading-none"
                  data-like-count-value
                  data-shop-id={String(shop.id)}
                >{shop.likeCount}</span>
              )}
              <button
                type="button"
                class="like-btn w-9 h-9 flex items-center justify-center rounded-lg text-stone-400 hover:text-red-400 hover:bg-stone-100 transition-colors cursor-pointer relative overflow-visible"
                data-action="like"
                data-shop-id={String(shop.id)}
                data-like-token={shop.likeToken}
                aria-label={`${shop.name} liken`}
              >
                <HeartIcon weight="regular" className="like-icon-regular w-5 h-5" />
                <HeartIcon weight="duotone" className="like-icon-duotone w-5 h-5 absolute hidden text-red-500" />
              </button>
              <button
                type="button"
                class="w-9 h-9 flex items-center justify-center rounded-lg text-stone-400 hover:text-amber-700 hover:bg-stone-100 transition-colors cursor-pointer"
                data-action="share"
                data-share-url={`${site}/shop/${shopToken}`}
                data-share-title={shop.name}
                aria-label={`${shop.name} teilen`}
              >
                <ShareNetworkIcon weight="duotone" className="w-5 h-5" />
              </button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Description -->
    {descriptionHtml && (
      <section class="mb-8">
        <div
          class="text-sm sm:text-base text-stone-600 leading-relaxed prose prose-stone max-w-none prose-p:my-3 prose-a:text-amber-700 prose-headings:font-serif"
          set:html={descriptionHtml}
        />
      </section>
    )}

    <!-- Info grid -->
    <div class="grid sm:grid-cols-2 gap-4 mb-8">
      {shop.shipping && (
        <div class="flex items-start gap-3 p-4 rounded-2xl bg-stone-50 border border-stone-100">
          <PackageIcon weight="duotone" className="w-5 h-5 text-stone-400 shrink-0 mt-0.5" />
          <div>
            <p class="text-xs font-medium text-stone-600 uppercase tracking-wide mb-1">Versand</p>
            <p class="text-sm text-stone-700">{shop.shipping}</p>
          </div>
        </div>
      )}

      {shop.pickup && (
        <div class="flex items-start gap-3 p-4 rounded-2xl bg-stone-50 border border-stone-100">
          <StorefrontIcon weight="duotone" className="w-5 h-5 text-stone-400 shrink-0 mt-0.5" />
          <div>
            <p class="text-xs font-medium text-stone-600 uppercase tracking-wide mb-1">Abholung</p>
            <p class="text-sm text-stone-700">{shop.pickup}</p>
          </div>
        </div>
      )}

      {shop.paymentMethods?.length > 0 && (
        <div class="p-4 rounded-2xl bg-stone-50 border border-stone-100 sm:col-span-2">
          <div class="mb-3 flex items-center gap-2">
            <CreditCardIcon weight="duotone" className="size-5 shrink-0 text-stone-400" />
            <p class="text-xs font-medium text-stone-600 uppercase tracking-wide">Zahlungsarten</p>
          </div>
          <PaymentMethodIcons
            methods={shop.paymentMethods}
            locale="de"
            className="gap-3 pl-7 text-stone-400"
            showLabels={false}
            iconSize={48}
          />
        </div>
      )}
    </div>

    <!-- Categories, with the visit as the action that belongs beside them -->
    <section class="mb-8">
      {shop.categories?.length > 0 && <SectionLabel class="mb-3">Kategorien</SectionLabel>}
      <!-- The row itself never wraps, so the button keeps its corner however
           many categories there are. The chips wrap inside their own box. -->
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
        <div class="flex flex-wrap gap-2 min-w-0">
          {shop.categories?.map((cat) => (
            <a
              href={`/category/${cat.slug}`}
              class="px-3 py-1.5 rounded-full text-sm font-medium bg-amber-50 text-amber-700/70 hover:bg-amber-100 hover:text-amber-700 transition-colors"
              data-analytics-event="category-click"
              data-analytics-source="shop-detail"
              data-category-id={String(cat.id)}
              data-category-slug={cat.slug}
              data-category-name={cat.name}
            >
              {cat.name}
            </a>
          ))}
        </div>
        <a
          href={visitUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="lmaa-invite-action shrink-0 max-sm:w-full max-sm:justify-center"
          data-analytics-event="shop-visit-click"
          data-analytics-source="shop-detail"
          data-shop-id={String(shop.id)}
          data-shop-name={shop.name}
          data-shop-domain={domain}
        >
          <ArrowSquareOutIcon weight="fill" aria-hidden="true" />
          Shop besuchen
        </a>
      </div>
    </section>


    <!-- Standort (Map) -->
    {hasMap && (
      <section>
        <SectionLabel class="mb-3 flex items-center gap-2">
          <MapPinIcon weight="duotone" className="w-5 h-5" />
          Standort
        </SectionLabel>
        <ShopLocationMap
          client:only="react"
          latitude={hq.latitude}
          longitude={hq.longitude}
          name={shop.name}
          className="rounded-[var(--map-radius)] border border-stone-100 h-100"
        />
      </section>
    )}

    <!-- What sits under the map: the route on the left, the reports on the
         right. Stepped in by half the map's radius, and only whilst a map
         stands above it, because that curve is what the inset answers to. -->
    <footer
      class:list={[
        "flex flex-wrap items-center gap-4",
        hasMap ? "justify-between mt-2" : "justify-center sm:justify-start pt-6",
      ]}
      style={hasMap ? "padding-inline: calc(var(--map-radius) / 2)" : undefined}
      data-shop-id={shop.id}
    >
      {hasMap ? (
        <a
          href={`https://www.openstreetmap.org/directions?to=${hq.latitude},${hq.longitude}#map=15/${hq.latitude}/${hq.longitude}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm text-stone-600 hover:text-amber-700 transition-colors"
        >
          Route planen ↗
        </a>
      ) : null}
      <div class="flex items-center gap-4" data-shop-actions>
        <button
          type="button"
          class="text-sm text-stone-500 hover:text-red-500 transition-colors"
          data-action="dead-link"
          data-shop-id={shop.id}
          data-dialog={deadDialogId}
          aria-label={`Defekten Link für ${shop.name} melden`}
        >
          Link defekt?
        </button>
        <button
          type="button"
          class="text-sm text-stone-500 hover:text-red-500 transition-colors"
          data-action="report"
          data-shop-id={shop.id}
          data-dialog={reportDialogId}
          aria-label={`${shop.name} melden`}
        >
          Shop melden
        </button>
      </div>
    </footer>
  </div>

  <!-- Dead link confirmation dialog -->
  <dialog
    id={deadDialogId}
    aria-labelledby={`${deadDialogId}-title`}
    aria-describedby={`${deadDialogId}-desc`}
    aria-modal="true"
    class="bg-[var(--ds-surface)] rounded-[var(--ds-radius-3xl)] shadow-[var(--ds-shadow-xl)] w-full max-w-md p-6 m-auto"
  >
    <h2 id={`${deadDialogId}-title`} class="font-serif text-xl font-semibold text-[var(--ds-text)] mb-1">
      Link defekt?
    </h2>
    <p id={`${deadDialogId}-desc`} class="text-sm text-[var(--ds-text-muted)] mb-6">
      Ist der Link von <span class="font-medium text-[var(--ds-text)]">{shop.name}</span> wirklich nicht mehr erreichbar?
    </p>
    <div class="flex gap-3 justify-end">
      <button
        type="button"
        class="h-9 px-4 text-sm text-[var(--ds-text-muted)] hover:text-[var(--ds-text)] transition-colors"
        data-dismiss
      >
        Abbrechen
      </button>
      <button
        type="button"
        class="h-9 px-5 bg-[var(--ds-btn-filled-bg)] text-[var(--ds-btn-filled-fg)] rounded-control text-sm font-medium hover:bg-[var(--ds-btn-filled-hover)] transition-colors"
        data-confirm="dead-link"
        data-shop-id={shop.id}
      >
        Ja, Link melden
      </button>
    </div>
  </dialog>

  <!-- Report/concern dialog -->
  <dialog
    id={reportDialogId}
    aria-labelledby={`${reportDialogId}-title`}
    aria-describedby={`${reportDialogId}-desc`}
    aria-modal="true"
    class="bg-[var(--ds-surface)] rounded-[var(--ds-radius-3xl)] shadow-[var(--ds-shadow-xl)] w-full max-w-md p-6 m-auto"
  >
    <div data-report-form>
      <h2 id={`${reportDialogId}-title`} class="font-serif text-xl font-semibold text-[var(--ds-text)] mb-1">
        Shop melden
      </h2>
      <p id={`${reportDialogId}-desc`} class="text-sm text-[var(--ds-text-muted)] mb-5">
        Du möchtest <span class="font-medium text-[var(--ds-text)]">{shop.name}</span> melden? Beschreibe kurz, warum dieser Shop deiner Meinung nach nicht auf lmaa.space gehört.
      </p>
      <div class="space-y-4">
        <textarea
          rows="4"
          placeholder="z. B. Shop verkauft keine fairen oder nachhaltigen Produkte, ist nicht mehr erreichbar, …"
          class="w-full px-3 py-2.5 border border-[var(--ds-border)] rounded-control text-sm bg-[var(--ds-input-bg)] text-[var(--ds-text)] placeholder:text-[var(--ds-text-subtle)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] resize-none"
          data-reason-input
        ></textarea>
        <p class="text-[var(--ds-danger-text)] text-xs hidden" data-error-msg></p>
        <div class="flex gap-3 justify-end">
          <button
            type="button"
            class="h-9 px-4 text-sm text-[var(--ds-text-muted)] hover:text-[var(--ds-text)] transition-colors"
            data-dismiss
          >
            Abbrechen
          </button>
          <button
            type="button"
            class="h-9 px-5 bg-[var(--ds-btn-filled-bg)] text-[var(--ds-btn-filled-fg)] rounded-control text-sm font-medium hover:bg-[var(--ds-btn-filled-hover)] transition-colors disabled:opacity-50"
            data-confirm="report"
            data-shop-id={shop.id}
          >
            Melden
          </button>
        </div>
      </div>
    </div>
    <div data-report-success class="text-center py-6 hidden">
      <p class="text-2xl mb-3">🙏</p>
      <h2 class="font-serif text-xl font-semibold text-[var(--ds-text)] mb-2">
        Danke für deinen Hinweis!
      </h2>
      <p class="text-sm text-[var(--ds-text-muted)] mb-6">
        Wir prüfen deine Meldung und handeln bei Bedarf.
      </p>
      <button
        type="button"
        class="h-9 px-6 bg-[var(--ds-btn-filled-bg)] text-[var(--ds-btn-filled-fg)] rounded-control text-sm font-medium hover:bg-[var(--ds-btn-filled-hover)] transition-colors"
        data-dismiss
      >
        Schließen
      </button>
    </div>
  </dialog>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-10">
    <SupportPromptSlot
      client:only="react"
      slot="shop-detail"
      shopSlug={shopToken}
      prompts={supportPrompts.prompts}
      limits={supportPrompts.limits}
      liveIds={supportPrompts.liveIds}
    />
  </div>
</BaseLayout>
