---
import DynamicForm from "@/components/islands/DynamicForm";
import RejectedShopsTable from "@/components/islands/RejectedShopsTable";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { apiGet } from "@/lib/api";
import {
  buildContentDescription,
  hasWideContentSegment,
  renderContentSegments,
  type ContentPageView,
  type RenderedContentSegment,
} from "@/lib/content-page-rendering";
import type { FormConfig } from "@lmaa/contracts";
import type { Category } from "@lmaa/shared";

const { slug } = Astro.params;
const forbiddenSlugs = new Set(["api", "uploads", "_astro", "favicon.ico", "sitemap.xml"]);
if (!slug || forbiddenSlugs.has(slug)) {
  return Astro.redirect("/404");
}

let page: ContentPageView | null = null;
try {
  const remote = await apiGet<{ title: string; content: string; showTitle: boolean }>(
    `/content/${slug}`,
  );
  page = { title: remote.title, content: remote.content, showTitle: remote.showTitle };
} catch {
  // Content page not found or API error — fall through to form check / 404
}

// If no content page found, try to resolve as a form config slug
let formConfig: FormConfig | null = null;
let categories: Category[] = [];

if (!page) {
  try {
    formConfig = await apiGet<FormConfig>(`/form-config-by-slug/${slug}`);
    categories = await apiGet<Category[]>("/categories");
  } catch {
    // Not a form either — fall through to 404
  }
}

if (!page && !formConfig) {
  return Astro.redirect("/404");
}

let description = "";
let contentSegments: RenderedContentSegment[] = [];
let hasWideContent = false;

if (page) {
  contentSegments = await renderContentSegments(page.content);
  hasWideContent = hasWideContentSegment(contentSegments);
  description = buildContentDescription(page.content);
}
---

{page ? (
  <BaseLayout title={page.title} description={description}>
    <div class:list={[hasWideContent ? "max-w-5xl" : "max-w-3xl", "mx-auto px-4 sm:px-6 py-14"]}>
      <article class="prose prose-stone prose-base max-w-none prose-a:text-amber-700 prose-a:no-underline hover:prose-a:underline prose-headings:font-serif">
        {page.showTitle && <h1>{page.title}</h1>}
        {
          contentSegments.map((segment) =>
            segment.type === "html" ? (
              <Fragment set:html={segment.html} />
            ) : (
              <RejectedShopsTable
                client:load
                defaultPageSize={segment.defaultPageSize}
                initialData={segment.initialData}
                storageKey={segment.storageKey}
              />
            ),
          )
        }
      </article>
    </div>
  </BaseLayout>
) : (
  <BaseLayout title={formConfig!.name}>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14">
      <DynamicForm client:only="react" formConfig={formConfig!} categories={categories} />
    </div>
  </BaseLayout>
)}
