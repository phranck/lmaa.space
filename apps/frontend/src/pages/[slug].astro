---
import ContentPage from "@/components/islands/ContentPage";
import BaseLayout from "@/layouts/BaseLayout.astro";

const { slug } = Astro.params;
const forbiddenSlugs = new Set(["api", "uploads", "_astro", "favicon.ico", "sitemap.xml"]);

if (!slug || forbiddenSlugs.has(slug)) {
  return Astro.redirect("/404");
}

const title = slug.charAt(0).toUpperCase() + slug.slice(1).replace(/-/g, " ");
---

<BaseLayout title={title}>
  <ContentPage client:only="react" slug={slug} />
</BaseLayout>
