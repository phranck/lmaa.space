---
import type { FormConfig } from "@lmaa/contracts";
import type { Category } from "@lmaa/shared";

import barlowCondensed500Url from "@/assets/fonts/barlow-condensed-500.woff2?url";
import ContentArticle from "@/components/ContentArticle.astro";
import DynamicForm from "@/components/islands/DynamicForm";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { apiGet } from "@/lib/api";
import {
  buildContentDescription,
  getContentWidthClass,
  renderContentSegments,
  type ContentPageView,
  type RenderedContentSegment,
} from "@/lib/content-page-rendering";

const { slug } = Astro.params;
const forbiddenSlugs = new Set(["api", "uploads", "_astro", "favicon.ico", "sitemap.xml"]);
if (!slug || forbiddenSlugs.has(slug)) {
  return Astro.redirect("/404");
}

let page: ContentPageView | null = null;
try {
  page = await apiGet<ContentPageView>(`/content/${slug}`);
} catch {
  // Content page not found or API error — fall through to form check / 404
}

// If no content page found, try to resolve as a form config slug
let formConfig: FormConfig | null = null;
let categories: Category[] = [];

if (!page) {
  try {
    formConfig = await apiGet<FormConfig>(`/form-config-by-slug/${slug}`);
    categories = await apiGet<Category[]>("/categories");
  } catch {
    // Not a form either — fall through to 404
  }
}

if (!page && !formConfig) {
  return Astro.redirect("/404");
}

let description = "";
let contentSegments: RenderedContentSegment[] = [];

if (page) {
  contentSegments = await renderContentSegments(page.content);
  description = buildContentDescription(page.content);
}
---

{page ? (
  <BaseLayout title={page.title} description={description} fontPreloads={[barlowCondensed500Url]}>
    <div class:list={[getContentWidthClass(page.contentWidth), "mx-auto px-4 sm:px-6 py-14"]}>
      <ContentArticle title={page.title} showTitle={page.showTitle} segments={contentSegments} />
    </div>
  </BaseLayout>
) : (
  <BaseLayout title={formConfig!.name}>
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-14">
      <DynamicForm client:only="react" formConfig={formConfig!} categories={categories} />
    </div>
  </BaseLayout>
)}
