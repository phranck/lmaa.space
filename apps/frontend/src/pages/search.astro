---
import FilterableSearchResults from "@/components/islands/FilterableSearchResults";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { apiGet } from "@/lib/api";
import { buildFilterQuery, parseFiltersFromUrl } from "@/lib/filter-query";
import type { Shop } from "@lmaa/shared";

const q = Astro.url.searchParams.get("q")?.trim() ?? "";
const filters = parseFiltersFromUrl(Astro.url);
const filterQuery = buildFilterQuery(filters);
const hasFilters = filterQuery.length > 0;

interface SearchResponse {
  shops: Shop[];
  categories: { id: number; slug: string; name: string; shopCount?: number }[];
  query: string;
  total: number;
}

let results: SearchResponse | null = null;
if (q.length >= 2) {
  try {
    const endpoint = hasFilters
      ? `/filtered/search?q=${encodeURIComponent(q)}&${filterQuery}`
      : `/search?q=${encodeURIComponent(q)}`;
    results = await apiGet<SearchResponse>(endpoint);
  } catch (err) {
    console.error("[SSR] /search fetch failed:", err);
  }
}

const initialResults = {
  shops: results?.shops ?? [],
  categories: results?.categories ?? [],
  total: results?.total ?? 0,
};
---

<BaseLayout
  title="Suche"
  description="Shops und Kategorien durchsuchen auf lmaa.space. Lokale Märkte. Alternative Anbieter."
  noindex={true}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <FilterableSearchResults
      client:load
      initialQuery={q}
      initialResults={initialResults}
      initialFilters={filters}
    />
  </div>
</BaseLayout>
