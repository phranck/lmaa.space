---
import ShopCard from "@/components/ShopCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { apiGet } from "@/lib/api";
import type { Shop } from "@lmaa/shared";

const q = Astro.url.searchParams.get("q")?.trim() ?? "";

interface SearchResponse {
  shops: Shop[];
  categories: { id: number; slug: string; name: string; shopCount?: number }[];
  query: string;
  total: number;
}

let results: SearchResponse | null = null;
if (q.length >= 2) {
  try {
    results = await apiGet<SearchResponse>(`/search?q=${encodeURIComponent(q)}`);
  } catch (err) {
    console.error("[SSR] /search fetch failed:", err);
  }
}

const shopResults = results?.shops ?? [];
const categoryResults = results?.categories ?? [];
const total = results?.total ?? 0;
const hasQuery = q.length >= 2;
---

<BaseLayout
  title="Suche"
  description="Shops und Kategorien durchsuchen – faire Amazon-Alternativen auf lmaa.space."
  noindex={true}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Search form -->
    <form
      method="GET"
      action="/search"
      class="flex flex-col items-center mb-10"
      data-analytics-search-source="search-page"
    >
      <input
        type="search"
        name="q"
        value={q}
        aria-label="Shop oder Kategorie suchen"
        placeholder="Shop oder Kategorie suchen…"
        class="w-full max-w-xl px-4 py-3 text-base rounded-xl border border-stone-300 bg-white focus:outline-none focus:ring-2 focus:ring-amber-500/40 focus:border-amber-500 transition-all"
      />
    </form>

    <!-- Status line -->
    {hasQuery && (
      <p class="text-sm text-stone-400 mb-6">
        {total} {total === 1 ? "Treffer" : "Treffer gefunden"}
      </p>
    )}

    <!-- No results -->
    {hasQuery && total === 0 && (
      <div class="text-center py-20 bg-stone-50 rounded-2xl border border-stone-100">
        <p class="text-stone-600 mb-2 font-medium">Keine Ergebnisse für „{q}"</p>
        <p class="text-sm text-stone-400 mb-6">
          Vielleicht ist dieser Shop noch nicht in der Liste?
        </p>
        <a
          href="/suggestion"
          class="inline-block px-6 py-3 bg-stone-900 text-white rounded-xl text-sm font-medium hover:bg-amber-700 transition-colors"
          data-analytics-event="site-link-click"
          data-analytics-kind="cta"
          data-analytics-placement="search-empty-state"
          data-analytics-label="Shop vorschlagen"
          data-analytics-href="/suggestion"
        >
          Shop vorschlagen
        </a>
      </div>
    )}

    <!-- Category results -->
    {categoryResults.length > 0 && (
      <section class="mb-10">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-4">
          Kategorien
        </h2>
        <div class="flex flex-wrap gap-2">
          {categoryResults.map((cat) => (
            <a
              href={`/category/${cat.slug}`}
              class="px-4 py-2 bg-white border border-stone-200 rounded-full text-sm font-medium text-stone-700 hover:border-amber-400 hover:text-amber-700 transition-colors"
              data-analytics-event="category-click"
              data-analytics-source="search-result"
              data-category-id={String(cat.id)}
              data-category-slug={cat.slug}
              data-category-name={cat.name}
            >
              {cat.name}
              {cat.shopCount !== undefined && (
                <span class="ml-1.5 text-stone-400">({cat.shopCount})</span>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Shop results -->
    {shopResults.length > 0 && (
      <section>
        <h2 class="text-xs font-semibold uppercase tracking-widest text-stone-400 mb-4">
          Shops
        </h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {shopResults.map((shop) => (
            <ShopCard shop={shop} analyticsSource="search-result" />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
