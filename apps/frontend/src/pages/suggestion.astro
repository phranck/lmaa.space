---
import SuggestForm from "@/components/islands/SuggestForm";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { apiGet } from "@/lib/api";
import type { Category } from "@lmaa/shared";

const categories = await apiGet<Category[]>("/categories");
---

<BaseLayout
  title="Shop vorschlagen"
  description="Kennst du einen fairen Online-Shop? Schlage ihn für lmaa.space vor und hilf der Community."
  noindex={true}
>
  <SuggestForm client:load categories={categories} />
</BaseLayout>
