---
import DynamicForm from "@/components/islands/DynamicForm";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { apiGet } from "@/lib/api";
import type { FormConfig } from "@lmaa/contracts";
import type { Category } from "@lmaa/shared";

let formConfig: FormConfig | null = null;
let categories: Category[] = [];

try {
  formConfig = await apiGet<FormConfig>("/form-config/suggestion-form");
  categories = await apiGet<Category[]>("/categories");
} catch {
  // Form config not found
}

if (!formConfig) {
  return Astro.redirect("/404");
}
---

<BaseLayout title={formConfig.name} noindex={true}>
  <div class="max-w-2xl mx-auto px-4 sm:px-6 py-14">
    <DynamicForm client:only="react" formConfig={formConfig} categories={categories} />
  </div>
</BaseLayout>
