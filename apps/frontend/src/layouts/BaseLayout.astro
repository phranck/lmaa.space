---
import Footer from "@/components/Footer.astro";
import type { SocialMediaProfile } from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { apiGet } from "@/lib/api";
import type { FooterConfig, SocialPreviewPublicImage } from "@lmaa/contracts";
import type { NavItem } from "@lmaa/shared";

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = "Lokale Märkte. Alternative Anbieter.",
  canonicalUrl,
  ogImage,
  noindex = false,
  jsonLd,
} = Astro.props;

const siteTitle = title
  ? `${title} · lmaa.space`
  : "lmaa.space – Lokale Märkte. Alternative Anbieter.";
const publicSite = Astro.site ?? new URL("https://lmaa.space");
const canonical =
  canonicalUrl ?? new URL(`${Astro.url.pathname}${Astro.url.search}`, publicSite).href;
const defaultOgImage = new URL("/og-image.jpg", publicSite).href;
let resolvedOgImage = ogImage ?? defaultOgImage;

function withPreviewVersion(url: string, version: string): string {
  const versionedUrl = new URL(url);
  versionedUrl.searchParams.set("v", version);
  return versionedUrl.href;
}

/**
 * Serializes a JSON-LD payload for safe inline embedding in a
 * `<script type="application/ld+json">` element.
 *
 * `JSON.stringify` does not escape `<`, so any field value containing
 * `</script>` (e.g. a user-submitted shop name) would terminate the script
 * element early and allow HTML/script injection (stored XSS). Escaping every
 * `<` to its unicode escape (backslash-u-003c) keeps the JSON semantically
 * identical while making a `</script>` breakout impossible.
 *
 * @param data - JSON-LD object to serialize.
 * @returns A JSON string safe to embed via `set:html`.
 */
function serializeJsonLd(data: Record<string, unknown>): string {
  return JSON.stringify(data).replace(/</g, "\\u003c");
}

let headerNav: NavItem[] = [];
let footerNav: NavItem[] = [];
let footerConfig: FooterConfig = { columns: [] };
let socialMediaProfiles: SocialMediaProfile[] = [];
try {
  [headerNav, footerNav, footerConfig, socialMediaProfiles] = await Promise.all([
    apiGet<NavItem[]>("/nav/header"),
    apiGet<NavItem[]>("/nav/footer"),
    apiGet<FooterConfig>("/footer-config"),
    apiGet<SocialMediaProfile[]>("/social-media-accounts/footer"),
  ]);
} catch {
  // Nav items, footer config, and social profiles optional, graceful degradation.
}

try {
  const socialPreviewImage = !ogImage
    ? await apiGet<SocialPreviewPublicImage | null>("/social-preview-image")
    : null;
  if (socialPreviewImage?.url) {
    resolvedOgImage = withPreviewVersion(socialPreviewImage.url, socialPreviewImage.version);
  }
} catch {
  // The social preview image is optional, fall back to /og-image.jpg.
}
---

<!doctype html>
<html lang="de" data-theme="theme-autumn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta name="impact-site-verification" content="f71c9705-1393-41b2-a3dd-e5361c0e1908" />
    <link rel="canonical" href={canonical} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <!-- Font preloads: real gerenderte Gewichte für Nav (400), Headlines (600) und Hero-Logo -->
    <link
      rel="preload"
      href="/fonts/barlow-condensed-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/barlow-condensed-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/dynapuff-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/fonts/fonts.css" />

    <!-- OG / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="lmaa.space" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- JSON-LD -->
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={serializeJsonLd(jsonLd)}
        />
      )
    }

    <!-- Theme color -->
    <meta name="theme-color" content="#1C1917" />

    <!-- Umami Analytics (privacy-friendly, no cookies) -->
    <script
      is:inline
      async
      src="https://umami.layered.work/script.js"
      data-website-id="ebec4dd2-b578-4f10-a416-6503c7fe2da0"
    ></script>
  </head>
  <body class="min-h-dvh flex flex-col">
    <Header navItems={headerNav} />
    <main class="flex-grow">
      <slot />
    </main>
    <Footer config={footerConfig} navItems={footerNav} socialMediaProfiles={socialMediaProfiles} />
    <script>
      import "@/styles/global.css";
      import "@/scripts/hls-video.ts";
      import "@/scripts/shop-actions.ts";
      import "@/scripts/site-analytics.ts";
    </script>
  </body>
</html>
