{
  "name": "lmaa-space",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.22.0 <23",
    "npm": ">=10 <11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev:frontend": "npm run dev -w @lmaa/frontend",
    "dev:backend": "npm run dev -w @lmaa/backend",
    "dev:dashboard": "npm run dev -w @lmaa/dashboard",
    "build": "npm run build -w @lmaa/shared && npm run build --workspaces --if-present",
    "build:frontend": "npm run build -w @lmaa/frontend",
    "build:backend": "npm run build -w @lmaa/backend",
    "build:dashboard": "npm run build -w @lmaa/dashboard",
    "ci:smoke": "test -f apps/dashboard/dist/index.html && node scripts/smoke-backend-bundle.mjs && node scripts/verify-deploy-artifacts.mjs && node scripts/check-web-fonts.mjs --dist apps/frontend/dist/client",
    "ci:quality": "npm run format:check && npm run build -w @lmaa/shared && npm run lint && npm run typecheck && npm run docs:code:check && npm run build && npm run ci:smoke",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "db:generate": "drizzle-kit generate",
    "db:doctor": "npm run db:doctor -w @lmaa/backend",
    "db:migrate": "npm run db:migrate -w @lmaa/backend",
    "db:studio": "drizzle-kit studio",
    "docs:code": "typedoc --options typedoc.json",
    "docs:code:check": "typedoc --options typedoc.json --emit none",
    "doctor": "react-doctor"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "react-doctor": "0.4.0",
    "typedoc": "^0.28.9",
    "typescript": "^5.7.3",
    "vite": "8.3.4"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-libvips-linuxmusl-x64": "1.3.2",
    "@img/sharp-linux-x64": "0.35.3",
    "@img/sharp-linuxmusl-x64": "0.35.3",
    "@rollup/rollup-linux-x64-gnu": "^4.59.0",
    "@rollup/rollup-linux-x64-musl": "^4.59.0"
  },
  "overrides": {
    "marked": "^17.0.3",
    "sharp": "^0.35.3"
  }
}
