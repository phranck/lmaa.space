{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Rules that need type information run through oxlint-tsgolint, which
  // builds each tsconfig's program with typescript-go.
  "options": {
    "typeAware": true,
  },
  // React and accessibility rules belong to React Doctor, which runs on oxlint
  // as well and keeps their exceptions in doctor.config.ts. Enabling them here
  // would report the same findings twice and need every exception twice.
  "plugins": ["typescript", "unicorn", "oxc", "import", "vitest"],
  "categories": {
    "correctness": "error",
  },
  "rules": {
    // Asks for a type parameter on every `vi.fn()`, which is a style choice the
    // tests do not follow.
    "vitest/require-mock-type-parameters": "off",
    // Vitest's `expect` takes a message as its second argument
    // (`@vitest/expect`, `<T>(actual: T, message?: string)`), which this rule
    // reports as a mistake.
    "vitest/valid-expect": "off",
    // The tests assert a result's tag first and then narrow on it to check the
    // payload, which the rule cannot follow.
    "vitest/no-conditional-expect": "off",
    // Every loop it reports copies the collection on purpose before changing
    // it: `og.ts` deletes search parameters while walking them, and the OpenAPI
    // schema walk adds to the set it iterates.
    "unicorn/no-useless-spread": "off",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          { "from": "package", "name": "invalidateQueries", "package": "@tanstack/query-core" },
          { "from": "package", "name": "NavigateFunction", "package": "react-router" },
          { "from": "package", "name": "test", "package": "node:test" },
        ],
      },
    ],
  },
  "overrides": [
    {
      // `expect(mock.method)` hands the mock to the assertion rather than
      // calling it, and a test that stringifies the wrong value fails rather
      // than misleading anybody.
      "files": ["**/__tests__/**", "**/*.test.ts", "**/*.test.tsx", "**/*.test.mjs"],
      "rules": {
        "typescript/unbound-method": "off",
        "typescript/no-base-to-string": "off",
      },
    },
    {
      // Both match control characters on purpose, to reject or strip them.
      "files": ["apps/backend/src/lib/email-address.ts", "apps/backend/src/lib/media-storage.ts"],
      "rules": {
        "eslint/no-control-regex": "off",
      },
    },
    {
      // `callEnableBanking` sends a body only when one is given, and no GET
      // request is ever given one.
      "files": ["apps/backend/src/services/enable-banking-client.ts"],
      "rules": {
        "unicorn/no-invalid-fetch-options": "off",
      },
    },
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/.astro/**",
    "**/*.d.ts",
    "**/drizzle/meta/**",
    // Written by `npm run docs:code`.
    "docs/reference/code/**",
  ],
}
