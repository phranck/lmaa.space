version = 1

[project]
name = 'lmaa.space'

[runtime]
start_timeout = '60s'
probe_interval = '250ms'
health_timeout = '2s'
shutdown_timeout = '10s'
log_tail_lines = 20

[[services]]
name = 'frontend'
command = 'npm run dev:frontend'
role = 'frontend'
port = 3000
host = 'localhost'
health_path = '/'

[[services]]
name = 'backend'
command = 'npm run dev:backend'
role = 'backend'
port = 4000
host = 'localhost'
health_path = '/health/backend'

[[services]]
name = 'dashboard'
command = 'npm run dev:dashboard'
role = 'dashboard'
port = 4500
host = 'localhost'
health_path = '/'
